def remove_tree(path):
    """rmtree that also clears overlayfs' mode-000 work directories."""
    for root, dirs, _ in os.walk(path):
        for d in dirs:
            try:
                os.chmod(os.path.join(root, d), 0o700)
            except OSError:
                pass
    shutil.rmtree(path, ignore_errors=True)


def setup_sglang():
    fetch_trellis()
    if running_server():
        fail("a b70 server runs from the image setup would change; `b70 stop` first")
    say("sglang: building trellis-serve's kernels and installing the plugin (a few minutes)")
    run_in("sglang", ["bash", "-euo", "pipefail", "-c", SGLANG_BUILD], write_root=True)
    remove_tree(os.path.join(STATE, "overlay"))            # the persistent overlay of earlier setups


def cmd_setup(a):
    fams = SETUPS if a.family == "all" else [a.family]
    setup_image()
    for fam in fams:
        if setup_done(fam) and not a.force:
            say(f"{fam}: already set up")
            continue
        {"glm": setup_glm, "sglang": setup_sglang, "dsv41": setup_dsv41}[fam]()
        with open(setup_marker(fam), "w") as f:
            json.dump(setup_wanted(fam), f)
        say(f"{fam}: setup done")


# ------------------------------------------------------------------------------------------------- info / prepare

def model_info(model_dir, store=None):
    fam, cfg = read_model(model_dir)
    info = {"model": os.path.abspath(model_dir), "family": fam, "model_type": cfg.get("model_type")}
    if fam:
        store = store or default_store(fam)
        info.update(setup=setup_done(fam), store=store, prepared=store_ready(fam, store),
                    parallel_max=1 if fam in ("glm", "dsv41") else 8,
                    context_max=65536 if fam in ("glm", "dsv41") else 217088)
    return info


def cmd_info(a):
    print(json.dumps(model_info(a.model, a.store), indent=1))


def make_store_dir(store):
    if not os.path.isdir(store):
        os.makedirs(store, exist_ok=True)
        # btrfs: no copy-on-write or checksums, so O_DIRECT reads work
        subprocess.run(["chattr", "+C", store], capture_output=True)


def cmd_prepare(a):
    prepare(a.model, a.store, a.force)


def prepare(model, store, force=False):
    a = argparse.Namespace(model=model, store=store, force=force)
    fam, _ = read_model(a.model)
    if not fam:
        fail(f"{a.model} is not a model b70 serves")
    if not setup_done(fam):
        fail(f"{fam} is not set up; run `b70 setup {fam}` first")
    store = os.path.abspath(a.store or default_store(fam))
    if fam == "dsv41":
        if dsv41_store_ready(store) and not a.force:
            say(f"dsv41: expert store already packed in {store}")
            return
        make_store_dir(store)
        say(f"dsv41: packing the routed experts into {store} (~105 GB, reads the whole model), then the drafter's")
        run_in("dsv41", ["python3", "-u", "-m", "dsv_xpu.pack_store", "/models", "/nvx"], model=os.path.abspath(a.model),
               store=store)
        run_in("dsv41", ["python3", "-u", "-c", "from dsv_xpu.pack_store import append_mtp; append_mtp('/models', '/nvx')"],
               model=os.path.abspath(a.model), store=store)
        return
    if fam != "glm":
        say(f"{fam} needs no prepare step" + (": the first load writes its NVMe store" if fam == "flashnext" else ""))
        return
    if glm_store_ready(store) and not a.force:
        say(f"glm: expert store already packed in {store}")
        return
    make_store_dir(store)
    say(f"glm: packing the routed experts into {store} (~95 GB, reads the whole model)")
    run_in("glm", ["python3", "-u", "/w/xpu/pack_store.py", "pack"], model=os.path.abspath(a.model), store=store)


# ------------------------------------------------------------------------------------------------ the b70q queue

class _UnixHTTP(http.client.HTTPConnection):
    def __init__(self, path, timeout):
        super().__init__("b70q", timeout=timeout)
        self.sock_path = path

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        self.sock.connect(self.sock_path)


def b70q_socket():
    return os.path.join(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}", "b70q.sock")


def b70q(method, path, body=None, timeout=20):
    """The b70q daemon's HTTP API over its unix socket; raises OSError when the daemon is not there."""
    c = _UnixHTTP(b70q_socket(), timeout)
    try:
        c.request(method, path, body=None if body is None else json.dumps(body),
                  headers={"content-type": "application/json"})
        r = c.getresponse()
        data = r.read()
        if r.status >= 400:
            raise OSError(f"b70q {method} {path}: HTTP {r.status} {data[:200]!r}")
        return json.loads(data or b"{}")
    except (http.client.HTTPException, ValueError) as e:
        raise OSError(f"b70q {method} {path}: {e}") from e
    finally:
        c.close()


def parse_duration(text):
    m = re.fullmatch(r"(\d+(?:\.\d+)?)([smhd]?)", text.strip())
    if not m:
        fail(f"bad duration {text} (use 90, 90s, 15m, 4h)")
    return float(m.group(1)) * {"": 1, "s": 1, "m": 60, "h": 3600, "d": 86400}[m.group(2)]


def queue_turn(owner, note, opts):
    """Waits in the b70q queue until this process holds the B70. Returns the ticket id, or None when the card is already
    ours (inside a queue job: B70Q_TICKET) or no queue daemon runs. While waiting it prints its place in line every
    minute (and when it changes). SIGTERM / SIGINT while waiting leaves the line and exits."""
    if os.environ.get("B70Q_TICKET"):
        return None
    try:
        t = b70q("POST", "/api/tickets", {"owner": owner, "kind": "run", "argv": sys.argv, "cwd": os.getcwd(),
                                          "client_pid": os.getpid(), "note": note, "opts": opts})
    except OSError:
        say("no b70q queue daemon; using the B70 without it")
        return None
    tid = t["id"]
    if t.get("nested"):
        return None

    def leave(signum, _frame):
        try:
            b70q("POST", f"/api/tickets/{tid}/cancel", timeout=5)
        except OSError:
            pass
        say(f"left the B70 queue (#{tid})")
        sys.exit(128 + signum)
    old = {sg: signal.signal(sg, leave) for sg in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)}
    last, last_at, down_since = None, 0.0, None
    try:
        while True:
            try:
                w = b70q("GET", f"/api/tickets/{tid}/wait?until=granted&timeout=8", timeout=30)
                down_since = None
            except OSError as e:
                down_since = down_since or time.time()
                if time.time() - down_since > 300:
                    say(f"lost the b70q daemon for 5 minutes ({e}); using the B70 without it")
                    return None
                time.sleep(2)
                continue
            tk = w["ticket"]
            if tk["state"] == "granted":
                say(f"the B70 is ours (b70q #{tid} {owner})")
                os.environ["B70Q_TICKET"] = str(tid)
                return tid
            if tk["state"] != "waiting":
                fail(f"b70q #{tid} {tk['state']} while waiting: {tk.get('end_reason')}", 75)
            msg = queue_wait_text(tid, w)
            if msg != last or time.time() - last_at >= 60:
                say(msg)
                last, last_at = msg, time.time()
    finally:
        for sg, h in old.items():
            signal.signal(sg, h)


def queue_wait_text(tid, w):
    """"waiting for the B70: 2 in line, ~6 min (dsv41-sweep has it)", from the ticket's wait reply and /api/state."""
    eta = None
    try:
        st = b70q("GET", "/api/state", timeout=5)
        mine = next((q for q in st.get("queue", []) if q.get("id") == tid), None)
        if mine and mine.get("eta_start"):
            eta = max(0, (mine["eta_start"] - st["t"]) / 60000)
    except OSError:
        pass
    status = (w.get("status") or {}).get("text") or "busy"
    where = f"{w.get('position', '?')} in line"
    return f"waiting for the B70: {where}{f', ~{eta:.0f} min' if eta is not None else ''} ({status})"


def queue_done(tid, rc):
    if tid is None:
        return
    for _ in range(10):
        try:
            b70q("POST", f"/api/tickets/{tid}/done", {"exit_code": rc}, timeout=5)
            return
        except OSError:
            time.sleep(1)


# ----------------------------------------------------------------------------------------------------- the guard

def b70_pci():
    """PCI address of the first GPU on the xe driver (the B70)."""
    for r in sorted(os.listdir("/sys/class/drm")):
        if not r.startswith("renderD"):
            continue
        dev = os.path.realpath(f"/sys/class/drm/{r}/device")
        if os.path.basename(os.path.realpath(os.path.join(dev, "driver"))) == "xe":
            return os.path.basename(dev), f"/dev/dri/{r}"
    return None, None


def avail_gb():
    with open("/proc/meminfo") as f:
        for line in f:
            if line.startswith("MemAvailable:"):
                return int(line.split()[1]) / 1048576
    return 0.0


def psi_full():
    try:
        with open("/proc/pressure/memory") as f:
            for line in f:
                if line.startswith("full"):
                    return float(line.split()[1].split("=")[1])
    except OSError:
        pass
    return 0.0


SHELLS = {"bash", "sh", "zsh", "dash", "fish", "grep", "timeout", "tail"}


def other_jobs(pattern, render, skip):
    """Processes whose command line matches `pattern` that have the B70's render node open (a Steam game)."""
    if not pattern or not render:
        return []
    rx = re.compile(pattern)
    found = []
    for pid in os.listdir("/proc"):
        if not pid.isdigit() or int(pid) in skip:
            continue
        try:
            args = open(f"/proc/{pid}/cmdline", "rb").read().replace(b"\0", b" ").decode(errors="replace")
            comm = open(f"/proc/{pid}/comm").read().strip()
            if comm in SHELLS or not rx.search(args):
                continue
            for fd in os.listdir(f"/proc/{pid}/fd"):
                if os.readlink(f"/proc/{pid}/fd/{fd}") == render:
                    found.append(f"{pid} {args[:100]}")
                    break
        except OSError:
            continue
    return found


FAULT = re.compile(r"Fault|CAT error|[Hh]ang|[Rr]eset|wedged|Timedout")


class Guard:
    """Runs the server in its own process group and stops the group on an xe fault, low RAM, memory pressure, or
    SIGTERM/SIGINT to this process. Who else may use the B70 is the b70q queue's business, not the guard's."""

    def __init__(self, ram_start_gb):
        self.ram_floor = float(os.environ.get("B70_RAM_FLOOR_GB", "4"))
        self.psi_max = float(os.environ.get("B70_PSI_MAX", "40"))
        self.ram_start = float(os.environ.get("B70_RAM_START_GB", ram_start_gb))
        self.games = os.environ.get("B70_GAMES", r"steamapps[/\\]common[/\\]")
        self.pci, self.render = b70_pci()
        self.proc = None
        self.reason = None
        self.lock = threading.Lock()

    def check_start(self):
        if not self.pci:
            fail("no GPU on the xe driver found (the B70 needs the xe kernel driver)")
        a = avail_gb()
        if a < self.ram_start:
            fail(f"GUARD: not starting, only {a:.0f} GB RAM available (need {self.ram_start:.0f})", 98)
        # a Steam game under Proton opens every GPU, the B70 too, even when it renders on another card; model loads
        # beside one failed binding B70 memory (UR_RESULT_ERROR_OUT_OF_DEVICE_MEMORY / DEVICE_LOST, xe "VM worker
        # error: -16"). Only checked at the start: a server already running is left alone.
        o = other_jobs(self.games, self.render, {os.getpid()})
        if o:
            fail(f"GUARD: not starting, a game has the B70 open: {o[0]}", 98)

    def stop(self, reason):
        with self.lock:
            if self.reason or not self.proc or self.proc.poll() is not None:
                return
            self.reason = reason
        print(f"GUARD: {reason}, stopping the server", flush=True)
        if reason != "asked to stop":       # who was using the memory, for the post-mortem
            top = subprocess.run(["ps", "-eo", "pid,rss,args", "--sort=-rss"], capture_output=True, text=True).stdout
            for line in top.splitlines()[1:9]:
                pid, rss, cmd = (line.split(None, 2) + ["", ""])[:3]
                print(f"GUARD   {pid:>8} {int(rss or 0) / 1048576:5.1f} GB  {cmd[:110]}", flush=True)
        try:
            os.killpg(self.proc.pid, signal.SIGTERM)
        except ProcessLookupError:
            return
        for _ in range(80):
            if self.proc.poll() is not None:
                return
            time.sleep(0.1)
        try:
            os.killpg(self.proc.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass

    def watch_kernel(self, t0):
        try:
            j = subprocess.Popen(["journalctl", "-k", "-f", "-n", "0", "--since", f"@{int(t0)}", "-o", "short-unix",
                                  "--no-pager"], stdout=subprocess.PIPE, text=True)
        except OSError:
            return
        tag = f"xe {self.pci}"
        for line in j.stdout:
            try:
                if float(line.split()[0]) < t0:
                    continue
            except (ValueError, IndexError):
                pass
            if tag in line and FAULT.search(line):
                self.stop(f"B70 fault in the kernel log: {line.strip()[:200]}")
            if self.proc.poll() is not None:
                break
        j.kill()

    def watch_memory(self):
        while self.proc.poll() is None and not self.reason:
            a, p = avail_gb(), psi_full()
            if a < self.ram_floor:
                self.stop(f"RAM low ({a:.1f} GB available, floor {self.ram_floor:.0f})")
            elif p > self.psi_max:
                self.stop(f"memory pressure {p:.0f}% (full avg10, max {self.psi_max:.0f}), {a:.1f} GB RAM available")
            time.sleep(1)

    def run(self, args, ready=None):
        t0 = time.time()

        def child():
            os.setsid()
            try:
                with open("/proc/self/oom_score_adj", "w") as f:
                    f.write("1000")       # the kernel OOM killer takes the server before anything of the user's
            except OSError:
                pass

        self.proc = subprocess.Popen(args, preexec_fn=child)
        for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            signal.signal(s, lambda *_: threading.Thread(target=self.stop, args=("asked to stop",)).start())
        threading.Thread(target=self.watch_kernel, args=(t0,), daemon=True).start()
        threading.Thread(target=self.watch_memory, daemon=True).start()
        if ready:
            threading.Thread(target=ready, daemon=True).start()
        while True:
            try:
                rc = self.proc.wait()
                break
            except InterruptedError:
                continue
        if self.reason and self.reason != "asked to stop":
            print(f"GUARD tripped: {self.reason}", flush=True)
            return 99
        return 0 if self.reason == "asked to stop" else rc


# ------------------------------------------------------------------------------------------- warm-up and port gate

def free_port():
    import socket
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def relay(listen_port, target_port):
    """Forward every TCP connection on 127.0.0.1:listen_port to target_port, byte for byte (streams, keep-alive and a
    client hanging up, which cancels its request, all pass through)."""
    import asyncio

    async def pipe(reader, writer):
        try:
            while data := await reader.read(65536):
                writer.write(data)
                await writer.drain()
        except (ConnectionError, OSError):
            pass
        finally:
            try:
                writer.close()
            except (ConnectionError, OSError):
                pass

    async def handle(client_r, client_w):
        try:
            up_r, up_w = await asyncio.open_connection("127.0.0.1", target_port)
        except OSError:
            client_w.close()
            return
        await asyncio.gather(pipe(client_r, up_w), pipe(up_r, client_w))

    async def main():
        server = await asyncio.start_server(handle, "127.0.0.1", listen_port, reuse_address=True)
        async with server:
            await server.serve_forever()

    asyncio.run(main())


def open_when_warm(a, warm, alive):
    """Wait for the server on its inner port, send it `warm` (one real request: kernels compile, graphs and caches
    fill), then open the requested port. Until then the port is closed, so a client never meets a server that is up
    but still warming (SGLang answered /v1/models seconds late right after its start, and client discovery with a
    short timeout found no model)."""
    url = f"http://127.0.0.1:{a.inner_port}"
    while alive():
        try:
            urllib.request.urlopen(f"{url}/v1/models", timeout=5).read()
            break
        except OSError:
            time.sleep(2)
    else:
        return
    t0 = time.time()
    try:
        urllib.request.urlopen(urllib.request.Request(f"{url}/v1/chat/completions", json.dumps(warm).encode(),
                                                      {"Content-Type": "application/json"}), timeout=900).read()
        say(f"warm-up request done in {time.time() - t0:.0f} s")
    except OSError as e:
        say(f"warm-up request failed ({e}); opening the port anyway")
    if alive():
        threading.Thread(target=relay, args=(a.port, a.inner_port), daemon=True).start()
        say(f"ready on http://127.0.0.1:{a.port}/v1")


