# Gemma 4 31B's KV budget on the B70 (memory fraction 0.85), in bf16 full-attention tokens (10 layers), and what a
# sliding-window token costs in those units (50 layers; bf16 / fp8). Fitted to the pools measured next to the drafter:
# 45.8K full + 4K SWA (bf16, one game), 60K + 4K (fp8 window), 44.9K + 8.2K (fp8, four games), 15.6K + 8.2K (bf16)
GEMMA_KV_UNITS = {True: 74000, False: 104000}      # with / without the drafter
GEMMA_SWA_UNITS = {False: 7.16, True: 3.58}        # bf16 / fp8 window


def serve_gemma(a, model, store):
    """Gemma 4 (dense, EXL3) on the same SGLang + trellis-serve install as Flash-Next."""
    users = max(1, min(a.parallel or 1, 8))
    ctx = a.ctx or 32768
    env = {
        "HF_HUB_OFFLINE": "1", "ZE_AFFINITY_MASK": "0",
        "EXL3_MODEL_PATH": "/model",
        "EXL3_LIB": "/opt/trellis-serve/xpu/exl3xpu/_C_sgl.so",
        "EXL3_MOE_LIB": "/opt/trellis-serve/xpu/exl3xpu/_moe_sgl.so",
        "TORCHINDUCTOR_COMPILE_THREADS": "1",
        "PYTORCH_ALLOC_CONF": "expandable_segments:True",
        # host copies through staging buffers: the copy engine reading a swapped page in place faulted the card
        # while loading (after 0xSero's omarchy-local-ai 6.8.2/6.8.3)
        "NEOReadDebugKeys": "1", "TreatNonUsmForTransfersAsSharedSystem": "0", "EnableSharedSystemUsmSupport": "0",
        "PYTHONPATH": "/opt/b70/pyhooks", "TRIM_EVERY_S": "300",
    }
    # the sliding-window pool (50 layers x 16 KV heads x 512, ~820 KB per token in bf16) only needs a prefill chunk
    # plus the 1024-token window per running request, and one window (plus a page) for each other game's cached
    # prompt (kvpack.py keeps one window per cached game); it gets that, and the full-attention pool the rest of the
    # budget (a full:SWA ratio spent most of the memory on the SWA pool)
    chunk = int(os.environ.get("B70_CHUNK", "2048"))       # 2048 read prompts as fast as 8192 and halves the SWA pool
    swa_tokens = int(os.environ.get("B70_SWA_TOKENS",
                                    str(chunk + users * (1024 + 384) + (users - 1) * (1024 + 128) + 512)))
    env["EXL3_SWA_TOKENS"] = str(swa_tokens)
    # smaller KV (kvpack.py). The sliding-window layers in fp8 halve their pool and decode as fast as bf16 for one
    # game, faster for several (1/2/4 games: 42/91/135 tok/s against 43.5/68.5/127); the full-attention layers packed
    # (4-bit, rotated keys) hold 3.2x the tokens, but attention unpacks each game's whole context every step (four
    # games at 20K: 19 tok/s each), so they are packed only when the unpacked pool cannot hold every game's context.
    # One game keeps the exact bf16 window while its context fits.
    memfrac = float(os.environ.get("B70_MEMFRAC", "0.85"))
    units = float(os.environ.get("B70_KV_UNITS", GEMMA_KV_UNITS[bool(a.drafter)]))
    room = {fp8: units - swa_tokens * GEMMA_SWA_UNITS[fp8] for fp8 in (False, True)}   # full-attention tokens
    auto_fp8 = users > 1 or ctx > room[False]
    fp8_window, pack_full = {"off": (False, False), "window": (True, False), "all": (True, True), "on": (True, True),
                             "auto": (auto_fp8, ctx * users > room[auto_fp8])}[a.kv_pack]
    if fp8_window:
        env["EXL3_KV_FP8_SWA"] = "1"
    if pack_full:
        # one request's unpack scratch: K and V of the 4 KV heads x 512, bf16, per context token
        scratch_gb = ctx * 4 * 512 * 2 * 2 / 2**30
        memfrac -= scratch_gb / 31.9 + 0.01
        env.update({"EXL3_KV_PACK": "1", "EXL3_KV_PACK_CTX": str(ctx)})
    env.update({k: v for k, v in os.environ.items() if k.startswith(("EXL3_", "SGLANG_"))})
    bs, graph_bs = 1, []
    while bs < users:
        graph_bs.append(bs)
        bs *= 2
    graph_bs.append(users)
    cmd = ["python3", "-m", "sglang.launch_server", "--model-path", "/model", "--quantization", "exl3",
           "--trust-remote-code", "--device", "xpu", "--host", "127.0.0.1", "--port", str(a.inner_port),
           "--served-model-name", a.name or "gemma-4",
           "--kv-cache-dtype", os.environ.get("B70_KV_DTYPE", "auto"), "--context-length", str(ctx),
           "--mem-fraction-static", f"{memfrac:.3f}",
           "--chunked-prefill-size", str(chunk), "--max-running-requests", str(users),
           "--dtype", "bfloat16", "--reasoning-parser", "gemma4", "--tool-call-parser", "gemma4",
           # a request asking for more output than its prompt leaves room for is cut to fit, as llama-server does
           "--allow-auto-truncate",
           "--attention-backend", os.environ.get("B70_ATTENTION", "intel_xpu"),
           # read each shard into RAM, one at a time, instead of mapping the files: the copy engine faulted the card
           # reading a cold mapped page while loading (xe "Engine memory CAT error", class=bcs), with the model's files
           # pushed out of the page cache; vLLM's --safetensors-load-strategy eager fixed the same fault
           "--weight-loader-disable-mmap", "--model-loader-extra-config", '{"enable_multithread_load": false}',
           # SGLang's own cache type stays bf16: Intel's attention kernel has no fp8 path for Gemma's 512-wide global
           # heads; kvpack.py stores the windows in fp8 and the global layers packed (see --kv-pack)
           ]
    if os.environ.get("B70_GRAPHS", "1") == "1":
        cmd += ["--cuda-graph-backend-decode", "full", "--cuda-graph-bs-decode", *map(str, graph_bs)]
    else:
        cmd += ["--disable-cuda-graph"]
    if a.chat_template:
        cmd += ["--chat-template", "/opt/chat_template.jinja"]
    cmd += shlex.split(os.environ.get("B70_SGLANG_ARGS", ""))       # experiments: any other SGLang option
    if a.drafter:
        # Google's assistant model drafts (SGLang runs it as FROZEN_KV_MTP: it reads the target's KV cache and
        # scores only the tokens of its top centroids)
        steps = int(os.environ.get("B70_DRAFT_TOKENS", "2"))
        cmd += ["--speculative-algorithm", "NEXTN", "--speculative-draft-model-path", "/drafter",
                "--speculative-num-steps", str(steps), "--speculative-eagle-topk", "1",
                "--speculative-num-draft-tokens", str(steps + 1)]
    warm = {"model": a.name or "gemma-4", "messages": [{"role": "user", "content": "Hello."}], "max_tokens": 1}
    return (sandbox("gemma", cmd, gpu=True, model=model, env=env, template=a.chat_template, drafter=a.drafter),
            25, warm)


def serve_flashnext(a, model, store):
    users = max(1, min(a.parallel or 1, 8))
    ctx = min(a.ctx or 204800, 217088)
    hot = "/opt/b70/hot"
    env = {
        "HF_HUB_OFFLINE": "1", "ZE_AFFINITY_MASK": "0",
        "EXL3_MODEL_PATH": "/model",
        "EXL3_LIB": "/opt/trellis-serve/xpu/exl3xpu/_C_sgl.so",
        "EXL3_MOE_LIB": "/opt/trellis-serve/xpu/exl3xpu/_moe_sgl.so",
        # experts the game-master turns route to most stay pinned in VRAM slots (route_to_hot.py over GM turns:
        # 94% of held-out decode routings against 39% for a generic profile)
        "EXL3_MOE_SLOTS": "7600", "EXL3_MOE_CACHE": "1", "EXL3_MOE_STATIC": "1",
        "EXL3_MOE_HOT": f"{hot}/{a.hot or 'gm-7500'}.json",
        # n-gram embedding table on NVMe behind a small RAM cache; give up on a late row after 1.5 s (xe resets a
        # compute job after 5 s)
        "EXL3_NGRAM_TIER": "nvme", "SGLANG_EXL3_NGRAM_TIER": "nvme", "SGLANG_EXL3_NGRAM_RAM_GB": "0.5",
        "SGLANG_EXL3_NGRAM_TIMEOUT_S": "1.5",
        # cap torch's cache at 90% of the card (decode graphs allocate outside it), log VRAM use, give cached prefill
        # blocks back before the reply
        "EXL3_TORCH_MEM_FRACTION": "0.90", "EXL3_MEM_LOG": "30", "EXL3_RELEASE_AFTER_PREFILL": "1",
        "TORCHINDUCTOR_COMPILE_THREADS": "1",
        "PYTORCH_ALLOC_CONF": "expandable_segments:True",
        # every server process hands freed heap back to the OS after the load (pyhooks/sitecustomize.py)
        "PYTHONPATH": "/opt/b70/pyhooks", "TRIM_EVERY_S": "300",
        # SGLang holds back waiting requests that share a prefix; here each prefill streams every non-resident
        # expert, so concurrent turns must batch into one forward instead
        "IN_BATCH_PREFIX_CACHING_DEPRIORITIZE_THRESHOLD": "1000000000",
    }
    if not a.all_ram:
        # only the experts in the RAM list keep a host copy; the rest live in the NVMe cold store, written on the first
