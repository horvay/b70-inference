SERVE_LOCK = os.path.join(STATE, "serve.lock")


def say(*a):
    print("b70:", *a, flush=True)


def fail(msg, code=1):
    print(f"b70: {msg}", file=sys.stderr, flush=True)
    sys.exit(code)


# ------------------------------------------------------------------------------------------------- models and state

def read_model(model_dir):
    """(family, config) of an EXL3 model folder, family None when b70 does not serve it."""
    try:
        with open(os.path.join(model_dir, "config.json")) as f:
            cfg = json.load(f)
    except (OSError, ValueError):
        return None, {}
    q = cfg.get("quantization_config") or {}
    if q.get("quant_method") != "exl3" and not os.path.exists(os.path.join(model_dir, "quantization_config.json")):
        return None, cfg
    return FAMILIES.get(cfg.get("model_type")), cfg


def default_store(family):
    return os.path.join(STATE, "stores", family)


def glm_store_ready(store):
    return os.path.exists(os.path.join(store, "glm53_flash_exl3_experts_blob.json"))


def patch_sha():
    with open(os.path.join(REPO, "flashnext", "trellis-serve.patch"), "rb") as f:
        return hashlib.sha256(f.read()).hexdigest()[:16]


def setup_marker(family):
    return os.path.join(STATE, f"setup-{family}.json")


def setup_wanted(family):
    """What a finished setup of `family` must have been built from; a change means setup runs again."""
    if family == "glm":
        sub = subprocess.run(["git", "-C", os.path.join(REPO, "glm", "exllamav3"), "rev-parse", "HEAD"],
                             capture_output=True, text=True)
        return {"exllamav3": sub.stdout.strip(), "build": file_sha(os.path.join(REPO, "glm", "xpu", "build.sh"))}
    src = "dev:" + TRELLIS if os.environ.get("B70_TRELLIS_SRC") else f"{TRELLIS_COMMIT}+{patch_sha()}"
    return {"trellis": src}


def file_sha(path):
    try:
        with open(path, "rb") as f:
            return hashlib.sha256(f.read()).hexdigest()[:16]
    except OSError:
        return None


def setup_done(family):
    try:
        with open(setup_marker(family)) as f:
            return json.load(f) == setup_wanted(family) and image_ready()
    except (OSError, ValueError):
        return False


def image_ready():
    return os.path.isfile(os.path.join(ROOTFS, "opt", "venv", "bin", "python3")) or \
        os.path.isfile(os.path.join(ROOTFS, "usr", "bin", "python3"))


# ------------------------------------------------------------------------------------------------------- sandbox

def image_env():
    with open(IMAGE_CONFIG) as f:
        env = dict(e.split("=", 1) for e in json.load(f)["config"].get("Env", []))
    return env


def sandbox(family, cmd, gpu=False, model=None, store=None, env=None, chdir=None, template=None):
    """The bwrap command line that runs `cmd` in the image for `family`.

    glm: the rootfs under a throw-away overlay, glm/ at /w (its build output, pylib, run/ and cache/ live there).
    flashnext: the rootfs under a persistent overlay (state/overlay/flashnext: the editable trellis-serve install and
    oneDNN wheels setup puts there), trellis-serve at /opt/trellis-serve, flashnext/ read-only at /opt/b70."""
    env = dict(env or {})
    img = image_env()
    args = ["bwrap"]
    if family == "glm":
        w = os.path.join(REPO, "glm")
        for d in ("run", "cache"):
            os.makedirs(os.path.join(w, d), exist_ok=True)
        args += ["--overlay-src", ROOTFS, "--tmp-overlay", "/"]
        binds = ["--bind", w, "/w", "--tmpfs", "/root", "--bind", os.path.join(w, "cache"), "/root/.cache"]
        pp = img.get("PYTHONPATH", "")
        env.setdefault("PYTHONPATH", "/w/xpu:/w/exllamav3:/w/pylib" + (":" + pp if pp else ""))
        env.setdefault("TRITON_CACHE_DIR", "/root/.cache/triton")
        chdir = chdir or "/w"
    else:
        up, wk = (os.path.join(STATE, "overlay", family, d) for d in ("upper", "work"))
        cache, run = os.path.join(STATE, "cache", family), os.path.join(STATE, "run", family)
        for d in (up, wk, cache, run):
            os.makedirs(d, exist_ok=True)
        args += ["--overlay-src", ROOTFS, "--overlay", up, wk, "/"]
        binds = ["--bind", TRELLIS, "/opt/trellis-serve", "--ro-bind", os.path.join(REPO, "flashnext"), "/opt/b70",
                 "--bind", run, "/run/b70", "--bind", cache, "/root/.cache"]
        chdir = chdir or "/opt/trellis-serve/xpu"
    args += ["--dev-bind", "/dev", "/dev"] if gpu else ["--dev", "/dev"]
    args += ["--proc", "/proc", "--ro-bind", "/sys", "/sys", "--tmpfs", "/tmp",
             "--ro-bind", "/etc/resolv.conf", "/etc/resolv.conf"]
    args += binds
    if model:
        args += ["--ro-bind", model, "/models" if family == "glm" else "/model"]
    if store:
        args += ["--bind", store, "/nvx"]
    if template:
        args += ["--ro-bind", template, "/opt/chat_template.jinja"]
    args += ["--setenv", "HOME", "/root"]
    try:
        tz = open("/etc/localtime", "rb").read().splitlines()[-1].decode()
        args += ["--setenv", "TZ", tz]
    except (OSError, IndexError, UnicodeDecodeError):
        pass
    for k, v in {**img, **env}.items():
        args += ["--setenv", k, str(v)]
    args += ["--unshare-pid", "--die-with-parent", "--chdir", chdir]
    return args + list(cmd)


def run_in(family, cmd, **kw):
    r = subprocess.run(sandbox(family, cmd, **kw))
    if r.returncode != 0:
        fail(f"{family}: `{' '.join(cmd)[:120]}` failed (exit {r.returncode})")


# --------------------------------------------------------------------------------------------------------- setup

def setup_image():
    if image_ready():
        return
    if not shutil.which("bwrap"):
        fail("bubblewrap (bwrap) is not installed; install it with your package manager")
    say(f"pulling {IMAGE[1]}@{IMAGE[2][:19]} into {ROOTFS} (~25 GB; resumes if interrupted)")
    os.makedirs(os.path.dirname(ROOTFS), exist_ok=True)
    r = subprocess.run([sys.executable, os.path.join(REPO, "common", "oci_pull.py"), *IMAGE, ROOTFS])
    if r.returncode != 0 or not image_ready():
        fail("pulling the image failed")


def setup_glm():
    if not os.path.isfile(os.path.join(REPO, "glm", "exllamav3", "exllamav3", "__init__.py")):
        r = subprocess.run(["git", "-C", REPO, "submodule", "update", "--init", "glm/exllamav3"])
        if r.returncode != 0:
            fail("glm/exllamav3 is missing and `git submodule update --init` failed")
    say("glm: installing llguidance and marisa-trie into glm/pylib")
    run_in("glm", ["pip", "install", "-q", "--no-deps", "--target", "/w/pylib", "llguidance==1.9.1",
                   "marisa-trie==1.4.1"])
    say("glm: building the SYCL kernels (a few minutes)")
    run_in("glm", ["bash", "/w/xpu/build.sh"])


def fetch_trellis():
    if os.environ.get("B70_TRELLIS_SRC"):
        if not os.path.isdir(os.path.join(TRELLIS, "xpu")):
            fail(f"B70_TRELLIS_SRC={TRELLIS} is not a trellis-serve checkout")
        return
    patch = os.path.join(REPO, "flashnext", "trellis-serve.patch")
    mark = os.path.join(TRELLIS, ".b70-patch")
    want = f"{TRELLIS_COMMIT}+{patch_sha()}"
    if open(mark).read().strip() == want if os.path.exists(mark) else False:
        return
    git = lambda *a: subprocess.run(["git", "-C", TRELLIS, *a], check=True)  # noqa: E731
    if not os.path.isdir(os.path.join(TRELLIS, ".git")):
        os.makedirs(TRELLIS, exist_ok=True)
        git("init", "-q")
        git("remote", "add", "origin", TRELLIS_REPO)
    say(f"flashnext: fetching trellis-serve {TRELLIS_COMMIT[:12]}")
    git("fetch", "-q", "--depth", "1", "origin", TRELLIS_COMMIT)
    git("checkout", "-q", "-f", TRELLIS_COMMIT)
    git("clean", "-q", "-fdx")
    git("apply", "--whitespace=nowarn", patch)
    with open(mark, "w") as f:
        f.write(want + "\n")


