# ------------------------------------------------------------------------------------------------- models and state

def read_model(model_dir):
    """(family, config) of an EXL3 model folder, family None when b70 does not serve it."""
    try:
        with open(os.path.join(model_dir, "config.json")) as f:
            cfg = json.load(f)
    except (OSError, ValueError):
        return None, {}
    q = cfg.get("quantization_config") or {}
    if q.get("quant_method") != "exl3" and not os.path.exists(os.path.join(model_dir, "quantization_config.json")):
        return None, cfg
    return FAMILIES.get(cfg.get("model_type")), cfg


def default_store(family):
    return os.path.join(STATE, "stores", family)


def glm_store_ready(store):
    return os.path.exists(os.path.join(store, "glm53_flash_exl3_experts_blob.json"))


def dsv41_store_ready(store):
    """The packed experts with the DSpark drafter's appended (pack_store.main, then append_mtp)."""
    try:
        with open(os.path.join(store, "experts.json")) as f:
            return "mtp_layers" in json.load(f)
    except (OSError, ValueError):
        return False


def store_ready(family, store):
    return {"glm": glm_store_ready, "dsv41": dsv41_store_ready}.get(family, lambda _: True)(store)


def patch_sha():
    with open(os.path.join(REPO, "trellis-serve.patch"), "rb") as f:
        return hashlib.sha256(f.read()).hexdigest()[:16]


def setup_marker(family):
    return os.path.join(STATE, f"setup-{family}.json")


def setup_wanted(family):
    """What a finished setup of `family` must have been built from; a change means setup runs again."""
    if family == "glm":
        sub = subprocess.run(["git", "-C", os.path.join(REPO, "glm", "exllamav3"), "rev-parse", "HEAD"],
                             capture_output=True, text=True)
        return {"exllamav3": sub.stdout.strip(), "build": file_sha(os.path.join(REPO, "glm", "xpu", "build.sh"))}
    if family == "dsv41":
        sub = subprocess.run(["git", "-C", REPO, "rev-parse", "HEAD:dsv41/exllamav3"], capture_output=True, text=True)
        csrc = os.path.join(REPO, "dsv41", "xpu", "csrc")
        kernels = hashlib.sha256()
        for name in sorted(os.listdir(csrc)) if os.path.isdir(csrc) else []:
            kernels.update(name.encode() + (file_sha(os.path.join(csrc, name)) or "").encode())
        return {"exllamav3": sub.stdout.strip(), "patch": file_sha(os.path.join(REPO, "dsv41", "exllamav3.patch")),
                "build": file_sha(os.path.join(REPO, "dsv41", "xpu", "build.sh")), "kernels": kernels.hexdigest()[:16]}
    src = "dev:" + TRELLIS if os.environ.get("B70_TRELLIS_SRC") else f"{TRELLIS_COMMIT}+{patch_sha()}"
    return {"trellis": src, "into": "rootfs"}


def file_sha(path):
    try:
        with open(path, "rb") as f:
            return hashlib.sha256(f.read()).hexdigest()[:16]
    except OSError:
        return None


def setup_done(family):
    family = INSTALL.get(family, family)
    try:
        with open(setup_marker(family)) as f:
            return json.load(f) == setup_wanted(family) and image_ready()
    except (OSError, ValueError):
        return False


def image_ready():
    return os.path.isfile(os.path.join(ROOTFS, "opt", "venv", "bin", "python3")) or \
        os.path.isfile(os.path.join(ROOTFS, "usr", "bin", "python3"))


# ------------------------------------------------------------------------------------------------------- sandbox

def image_env():
    with open(IMAGE_CONFIG) as f:
        env = dict(e.split("=", 1) for e in json.load(f)["config"].get("Env", []))
    return env


def sandbox(family, cmd, gpu=False, model=None, store=None, env=None, chdir=None, template=None, drafter=None,
            write_root=False):
    """The bwrap command line that runs `cmd` in the image for `family`, the rootfs under a throw-away overlay (each
    sandbox its own: a shared persistent overlay was busy for a moment after every sandbox exited).

    glm: glm/ at /w (its build output, pylib, run/ and cache/ live there).
    dsv41: the repo at /w (dsv41/ runs on glm/'s kernels and pylib), from /w/dsv41; the model's shards that are links
    into other drives (the Engram tables) are bound at their own paths.
    sglang: trellis-serve at /opt/trellis-serve, flashnext/ read-only at /opt/b70; setup (write_root) installs
    oneDNN and the editable trellis-serve into the rootfs itself, which is b70's own copy of the image."""
    family = INSTALL.get(family, family)
    env = dict(env or {})
    img = image_env()
    args = ["bwrap"]
    if family == "glm":
        w = os.path.join(REPO, "glm")
        for d in ("run", "cache"):
            os.makedirs(os.path.join(w, d), exist_ok=True)
        args += ["--overlay-src", ROOTFS, "--tmp-overlay", "/"]
        binds = ["--bind", w, "/w", "--tmpfs", "/root", "--bind", os.path.join(w, "cache"), "/root/.cache"]
        pp = img.get("PYTHONPATH", "")
        env.setdefault("PYTHONPATH", "/w/xpu:/w/exllamav3:/w/pylib" + (":" + pp if pp else ""))
        env.setdefault("TRITON_CACHE_DIR", "/root/.cache/triton")
        chdir = chdir or "/w"
    elif family == "dsv41":
        w = os.path.join(REPO, "dsv41")
        for d in ("run", "cache"):
            os.makedirs(os.path.join(w, d), exist_ok=True)
        args += ["--overlay-src", ROOTFS, "--tmp-overlay", "/"]
        binds = ["--bind", REPO, "/w", "--tmpfs", "/root", "--bind", os.path.join(w, "cache"), "/root/.cache"]
        for d in linked_dirs(model):
            binds += ["--ro-bind", d, d]
        pp = img.get("PYTHONPATH", "")
        env.setdefault("PYTHONPATH", "/w/dsv41/xpu:/w/glm/xpu:/w/dsv41/exllamav3:/w/glm/pylib" + (":" + pp if pp else ""))
        env.setdefault("TRITON_CACHE_DIR", "/root/.cache/triton")
        env.setdefault("SYCL_CACHE_PERSISTENT", "1")
        env.setdefault("SYCL_CACHE_DIR", "/root/.cache/sycl")
        chdir = chdir or "/w/dsv41"
    else:
        cache, run = os.path.join(STATE, "cache", family), os.path.join(STATE, "run", family)
        for d in (cache, run):
            os.makedirs(d, exist_ok=True)
        args += ["--bind", ROOTFS, "/"] if write_root else ["--overlay-src", ROOTFS, "--tmp-overlay", "/"]
        binds = ["--bind", TRELLIS, "/opt/trellis-serve", "--ro-bind", os.path.join(REPO, "flashnext"), "/opt/b70",
                 "--bind", run, "/run/b70", "--bind", cache, "/root/.cache"]
        chdir = chdir or "/opt/trellis-serve/xpu"
    args += ["--dev-bind", "/dev", "/dev"] if gpu else ["--dev", "/dev"]
    args += ["--proc", "/proc", "--ro-bind", "/sys", "/sys", "--tmpfs", "/tmp",
             "--ro-bind", "/etc/resolv.conf", "/etc/resolv.conf"]
    args += binds
    if model:
        args += ["--ro-bind", model, "/models" if family in ("glm", "dsv41") else "/model"]
    if store:
        args += ["--bind", store, "/nvx"]
    if template:
        args += ["--ro-bind", template, "/opt/chat_template.jinja"]
    if drafter:
        args += ["--ro-bind", drafter, "/drafter"]
    args += ["--setenv", "HOME", "/root"]
    try:
        tz = open("/etc/localtime", "rb").read().splitlines()[-1].decode()
        args += ["--setenv", "TZ", tz]
    except (OSError, IndexError, UnicodeDecodeError):
        pass
    for k, v in {**img, **env}.items():
        args += ["--setenv", k, str(v)]
    args += ["--unshare-pid", "--die-with-parent", "--chdir", chdir]
    return args + list(cmd)


def linked_dirs(model):
    """Directories outside the model folder that its files link to (DSV4.1's Engram shards often live on other
    drives), each bound read-only at its own path."""
    dirs = []
    if not model:
        return dirs
    for name in sorted(os.listdir(model)):
        path = os.path.join(model, name)
        if os.path.islink(path):
            d = os.path.dirname(os.path.realpath(path))
            if d not in dirs and os.path.isdir(d):
                dirs.append(d)
    return dirs


def run_in(family, cmd, **kw):
    r = subprocess.run(sandbox(family, cmd, **kw))
    if r.returncode != 0:
        fail(f"{family}: `{' '.join(cmd)[:120]}` failed (exit {r.returncode})")


# --------------------------------------------------------------------------------------------------------- setup

def setup_image():
    if image_ready():
        return
    if not shutil.which("bwrap"):
        fail("bubblewrap (bwrap) is not installed; install it with your package manager")
    say(f"pulling {IMAGE[1]}@{IMAGE[2][:19]} into {ROOTFS} (~25 GB; resumes if interrupted)")
    os.makedirs(os.path.dirname(ROOTFS), exist_ok=True)
    r = subprocess.run([sys.executable, os.path.join(REPO, "common", "oci_pull.py"), *IMAGE, ROOTFS])
    if r.returncode != 0 or not image_ready():
        fail("pulling the image failed")


def setup_glm():
    if not os.path.isfile(os.path.join(REPO, "glm", "exllamav3", "exllamav3", "__init__.py")):
        r = subprocess.run(["git", "-C", REPO, "submodule", "update", "--init", "glm/exllamav3"])
        if r.returncode != 0:
            fail("glm/exllamav3 is missing and `git submodule update --init` failed")
    say("glm: installing llguidance and marisa-trie into glm/pylib")
    run_in("glm", ["pip", "install", "-q", "--no-deps", "--target", "/w/pylib", "llguidance==1.9.1",
                   "marisa-trie==1.4.1"])
    say("glm: building the SYCL kernels (a few minutes)")
    run_in("glm", ["bash", "/w/xpu/build.sh"])


def setup_dsv41():
    if not setup_done("glm"):
        fail("dsv41 runs on the glm install's kernels and pylib; run `b70 setup glm` first")
    sub = os.path.join(REPO, "dsv41", "exllamav3")
    if not os.path.isfile(os.path.join(sub, "exllamav3", "__init__.py")):
        r = subprocess.run(["git", "-C", REPO, "submodule", "update", "--init", "dsv41/exllamav3"])
        if r.returncode != 0:
            fail("dsv41/exllamav3 is missing and `git submodule update --init` failed")
    # B70 changes to vcruz305's fork (lenient draft acceptance, XPU device checks, tile sizes, the row-blocked indexer)
    patch = os.path.join(REPO, "dsv41", "exllamav3.patch")
    applied = subprocess.run(["git", "-C", sub, "apply", "--reverse", "--check", patch], capture_output=True)
    if applied.returncode != 0:
        say("dsv41: applying dsv41/exllamav3.patch")
        if subprocess.run(["git", "-C", sub, "apply", "--whitespace=nowarn", patch]).returncode != 0:
            fail("dsv41/exllamav3.patch does not apply to dsv41/exllamav3 (local changes there?)")
    say("dsv41: building the SYCL kernels (a few minutes)")
    run_in("dsv41", ["bash", "/w/dsv41/xpu/build.sh"])


def fetch_trellis():
    if os.environ.get("B70_TRELLIS_SRC"):
        if not os.path.isdir(os.path.join(TRELLIS, "xpu")):
            fail(f"B70_TRELLIS_SRC={TRELLIS} is not a trellis-serve checkout")
        return
    patch = os.path.join(REPO, "trellis-serve.patch")
    mark = os.path.join(TRELLIS, ".b70-patch")
    want = f"{TRELLIS_COMMIT}+{patch_sha()}"
    if open(mark).read().strip() == want if os.path.exists(mark) else False:
        return
    git = lambda *a: subprocess.run(["git", "-C", TRELLIS, *a], check=True)  # noqa: E731
    if not os.path.isdir(os.path.join(TRELLIS, ".git")):
        os.makedirs(TRELLIS, exist_ok=True)
        git("init", "-q")
        git("remote", "add", "origin", TRELLIS_REPO)
    say(f"sglang: fetching trellis-serve {TRELLIS_COMMIT[:12]}")
    git("fetch", "-q", "--depth", "1", "origin", TRELLIS_COMMIT)
    git("checkout", "-q", "-f", TRELLIS_COMMIT)
    git("clean", "-q", "-fdx")
    git("apply", "--whitespace=nowarn", patch)
    with open(mark, "w") as f:
        f.write(want + "\n")


