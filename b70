ROOTFS = os.path.realpath(os.environ.get("B70_ROOTFS") or os.path.join(STATE, "image", "rootfs"))
IMAGE_CONFIG = os.path.join(REPO, "common", "image-config.json")
# lmsysorg/sglang:v0.5.20-xpu (torch 2.13 XPU, Triton XPU, oneAPI 2026.0 with icpx)
IMAGE = ("registry-1.docker.io", "lmsysorg/sglang",
         "sha256:e4e10d66de374e6e8cc88136e8dbfc3182787070df8a48e581fb007cc7a51c36")
TRELLIS_REPO = "https://github.com/0xSero/trellis-serve.git"
