        env.update({"EXL3_MOE_RAM": f"{hot}/{a.ram_list or 'gm-ram-4500'}.json",
                    "EXL3_MOE_COLD_STORE": "/nvx/qwen38_cold_experts",
                    "EXL3_MOE_RAM_MARGIN": str(a.margin if a.margin is not None else 0.5)})
    env.update({k: v for k, v in os.environ.items() if k.startswith(("EXL3_", "SGLANG_"))})
    bs, graph_bs = 1, []
    while bs < users:
        graph_bs.append(bs)
        bs *= 2
    graph_bs.append(users)
    cmd = ["python3", "-m", "sglang.launch_server", "--model-path", "/model", "--quantization", "exl3",
           "--trust-remote-code", "--device", "xpu", "--host", "127.0.0.1", "--port", str(a.inner_port),
           "--served-model-name", a.name or "flashnext-uncensored",
           "--disable-shared-experts-fusion", "--kv-cache-dtype", "fp8_e4m3", "--context-length", str(ctx),
           "--mem-fraction-static", "0.785", "--chunked-prefill-size", "8192", "--max-running-requests", str(users),
           "--dtype", "bfloat16", "--reasoning-parser", "qwen3", "--tool-call-parser", "qwen3_coder",
           "--allow-auto-truncate",
           "--linear-attn-prefill-backend", "intel_xpu", "--linear-attn-decode-backend", "intel_xpu",
           "--cuda-graph-backend-decode", "full", "--cuda-graph-bs-decode", *map(str, graph_bs),
           # linear-attention state slots, in bf16 (~57 MB each; fp32 doubled them and halved the full-attention pool
           # at 4 games; greedy replies differ from fp32 no more than fp32 runs differ from each other): a running
           # request takes 5, and each game's cached prompt keeps up to 2 (12 capped any --parallel at 2 running games)
           "--max-mamba-cache-size", str(max(12, 8 * users)), "--mamba-max-states-per-path", "2",
           "--mamba-ssm-dtype", "bfloat16", "--max-total-tokens", "217088"]
    cmd += shlex.split(os.environ.get("B70_SGLANG_ARGS", ""))       # experiments: any other SGLang option
    if a.chat_template:
        cmd += ["--chat-template", "/opt/chat_template.jinja"]
    make_store_dir(store)

    # a ~5K-token prompt: the first long prompt after a start pays ~2.5 s of one-time setup
    with open(os.path.join(REPO, "flashnext", "hot", "warmup_prompt.json")) as f:
        warm = json.load(f)
    warm.update(max_tokens=1, model=a.name or "flashnext-uncensored")
    return (sandbox("flashnext", cmd, gpu=True, model=model, store=store, env=env, template=a.chat_template),
            45 if a.all_ram else 25, warm)


def cmd_serve(a):
    model = os.path.abspath(a.model)
    fam, _ = read_model(model)
    if not fam:
        fail(f"{model} is not a model b70 serves (Gemma 4, GLM-5.3-Flash, Qwen3.8-Flash-Next or DeepSeek-V4.1-Flash EXL3)")
    if not setup_done(fam):
        fail(f"{fam} is not set up; run `b70 setup {fam}` first")
    store = os.path.abspath(a.store or default_store(fam))
    if a.chat_template:
        a.chat_template = os.path.abspath(a.chat_template)
    if a.drafter:
        a.drafter = os.path.realpath(a.drafter)
    os.makedirs(STATE, exist_ok=True)
    if a.prepare:
        prepare(model, store)        # CPU and disk only: before the queue
    a.inner_port = free_port()
    args, ram_start, warm = {"glm": serve_glm, "flashnext": serve_flashnext, "gemma": serve_gemma,
                             "dsv41": serve_dsv41}[fam](a, model, store)
    if a.dry_run:
        print(shlex.join(args))
        return
    # one model on the B70 at a time: the queue hands the card over; idle on the GPU for --idle while another job
    # waits, the queue stops this server (SIGTERM), and its caller starts it again when it is needed
    tid = queue_turn(a.queue, f"b70 serve {a.name or os.path.basename(model)}",
                     {"server": True, "idle_s": parse_duration(a.idle), "ram_gib": ram_start})
    guard = Guard(ram_start)
    guard.check_start()
    with open(SERVE_INFO, "w") as f:
        json.dump({"pid": os.getpid(), "port": a.port, "model": model, "family": fam, "b70q_ticket": tid}, f)
    say(f"loading {os.path.basename(model)} ({fam}); http://127.0.0.1:{a.port}/v1 opens once it is warm")
    rc = 1
    try:
        rc = guard.run(args, lambda: open_when_warm(a, warm, lambda: guard.proc.poll() is None and not guard.reason))
    finally:
        queue_done(tid, rc)
        try:
            with open(SERVE_INFO) as f:
                if json.load(f).get("pid") == os.getpid():
                    os.unlink(SERVE_INFO)
        except (OSError, ValueError):
            pass
    sys.exit(rc)


def running_server():
    """The `b70 serve` recorded in state/serve.json, if that process still runs."""
    try:
        with open(SERVE_INFO) as f:
            info = json.load(f)
        with open(f"/proc/{int(info['pid'])}/cmdline", "rb") as f:
            argv = f.read().split(b"\0")
    except (OSError, ValueError, KeyError, TypeError):
        return None
    return info if b"serve" in argv else None


def cmd_run(a):
    """A command inside an install's sandbox, without the GPU (tests, studies); state/run/<install> is /run/b70."""
    env = {"PYTHONPATH": "/run/b70/py"} if a.install == "sglang" else {}
    if a.gpu:
        env["ZE_AFFINITY_MASK"] = "0"
        tid = queue_turn(a.queue, f"b70 run {a.install} {shlex.join(a.command)[:60]}", {})
        guard = Guard(10)
        guard.check_start()
        rc = 1
        try:
            rc = guard.run(sandbox(a.install, a.command, gpu=True, env=env))
        finally:
            queue_done(tid, rc)
        sys.exit(rc)
    r = subprocess.run(sandbox(a.install, a.command, env=env))
    sys.exit(r.returncode)


def cmd_status(_):
    print(json.dumps({"running": running_server()}, indent=1))


def sandboxes():
    """PIDs of bwrap sandboxes over this state's image (a server's lasts a moment past `serve`)."""
    pids = []
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                argv = f.read().split(b"\0")
        except OSError:
            continue
        if argv and os.path.basename(argv[0]) == b"bwrap" and ROOTFS.encode() in argv:
            pids.append(int(pid))
    return pids


def cmd_stop(_):
    info = running_server()
    if not info:
        say("not running")
        return
    os.kill(info["pid"], signal.SIGTERM)
    for _ in range(150):
        if not running_server():
            break
        time.sleep(0.2)
    else:
        os.kill(info["pid"], signal.SIGKILL)
    # the overlay stays mounted until the sandbox is gone; a new server could not mount it before
    for _ in range(100):
        if not sandboxes():
            break
        time.sleep(0.2)
    say("stopped")


def main():
    ap = argparse.ArgumentParser(prog="b70", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("setup")
    p.add_argument("family", nargs="?", default="all", choices=["all", *SETUPS])
    p.add_argument("--force", action="store_true")
    p.set_defaults(fn=cmd_setup)
    p = sub.add_parser("info")
    p.add_argument("model")
    p.add_argument("--store")
    p.set_defaults(fn=cmd_info)
    p = sub.add_parser("prepare")
    p.add_argument("model")
    p.add_argument("--store")
    p.add_argument("--force", action="store_true")
    p.set_defaults(fn=cmd_prepare)
    p = sub.add_parser("serve")
    p.add_argument("model")
    p.add_argument("--port", type=int, required=True)
    p.add_argument("--ctx", type=int, help="context length in tokens")
    p.add_argument("--parallel", type=int, help="requests at once (Gemma and Flash-Next up to 8; GLM and DSV4.1 "
                                                "serve one)")
    p.add_argument("--name", help="model name the API answers to")
    p.add_argument("--store", help="NVMe expert store directory")
    p.add_argument("--all-ram", action="store_true", help="flashnext: every non-VRAM expert in RAM (~33 GB) instead "
                                                          "of the RAM list + NVMe cold store (~15 GB)")
    p.add_argument("--ram-list", help="flashnext: RAM list in flashnext/hot/ (default gm-ram-4500)")
    p.add_argument("--hot", help="flashnext: VRAM list in flashnext/hot/ (default gm-7500)")
    p.add_argument("--margin", type=float, help="flashnext: decode router margin against RAM experts (default 0.5)")
    p.add_argument("--ram-gb", type=float, help="glm, dsv41: RAM tier size in GB (default 27 / 24)")
    p.add_argument("--chat-template", help="Jinja chat template to serve with instead of the model's own")
    p.add_argument("--drafter", help="gemma: an assistant model folder that drafts tokens (gemma-4-*-assistant)")
    p.add_argument("--kv-pack", choices=["auto", "window", "all", "on", "off"], default="auto",
                   help="gemma: smaller KV cache: `window` keeps the sliding-window layers in fp8, `all` (or `on`) "
                        "also packs the full-attention layers to 4 bits (3.2x the tokens, decode slows with context); "
                        "auto: fp8 windows for 2+ games or a context bf16 cannot hold, and all when the unpacked "
                        "full-attention layers cannot hold --ctx x --parallel")
    p.add_argument("--prepare", action="store_true", help="run `prepare` first when the model needs it (GLM and "
                                                          "DSV4.1: packs the NVMe store, ~95 / ~105 GB, once)")
    p.add_argument("--dry-run", action="store_true", help="print the sandbox command instead of running it")
    p.add_argument("--queue", default=os.environ.get("B70Q_OWNER") or "b70",
                   help="owner name in the b70q queue (default $B70Q_OWNER or b70; nq-… goes next in line)")
    p.add_argument("--idle", default="15m", help="the queue stops the server after this long idle on the GPU while "
                                                 "another job waits (default 15m)")
    p.set_defaults(fn=cmd_serve)
    p = sub.add_parser("run", help="run a command in an install's sandbox, without the GPU")
    p.add_argument("--gpu", action="store_true", help="with the B70 (its turn in the b70q queue), under the guard "
                                                      "(kernel tests, benchmarks)")
    p.add_argument("--queue", default=os.environ.get("B70Q_OWNER") or "b70-run", help="owner name in the b70q queue")
    p.add_argument("install", choices=SETUPS)
    p.add_argument("command", nargs=argparse.REMAINDER)
    p.set_defaults(fn=cmd_run)
    sub.add_parser("status").set_defaults(fn=cmd_status)
    sub.add_parser("stop").set_defaults(fn=cmd_stop)
    a = ap.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
