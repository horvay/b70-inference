// DeepSeek-V4 / V4.1 decode attention on the Arc Pro B70 (one query token per job, B jobs per launch) + small decode
// ops (RMS norm over strided rows, SiLU * up with clamps, hyper-connection residual update).
//
// attn_decode: MQA over the job's virtual key list [sliding window (<= 128 rows: this token's kv + ring rows) ++
// pool entries (selected by indices, paged through the block table)], V is K, 64 heads x 512 dims. Split phase: one
// work-group per (job, 32-key slice) for all heads, keys staged in SLM, partial (m, l, acc) to a workspace. Combine:
// one work-group per (job, head): attention sink, normalization, de-rotation of the rope dims at the query position
// (GPT-J pairs, negated frequency table), fp16 store group-major (groups, B, heads_per_group * 512); the (job, head 0)
// work-group also appends this token's kv to the job's ring (after every split has read the ring).
#include <torch/all.h>
#include <torch/library.h>
#include <c10/xpu/XPUStream.h>
#include <sycl/sycl.hpp>

namespace dsvattn {

using half = sycl::half;
constexpr int HD = 512, NH = 64, NK = 32;
constexpr float NEG = -1e30f;          // "minus infinity" (built with -ffast-math: no real infinities)

// Query rows (one token each; a job may own several consecutive rows: verify blocks, drafter blocks). meta [R, MS]:
//   0 qpos (de-rotation position)   1 window floor (lowest visible position)   2 ring_beg (contiguous ring: position of
//   row 0)   3 slot   4 wrow (ring row to append this row's kv at, -1: none)   5 n_pool (pool entries attended)
//   6 chunk_pos0 (positions >= it come from the kv rows of this call)   7 kv_off (kv row = position + kv_off)
//   8 win_top (highest visible window position: qpos causal, the block's last position non-causal)
//   9 idx_row (indices row)   10 bt_row (block-table row = job)   11 -
// Window keys are win_top, win_top - 1, ... >= floor (at most WSPAN). Older window rows come from the ring:
// contiguous per slot (main model) or paged through the block table at 256 rows per page (DSpark drafter main-kv).
constexpr int MS = 12, WSPAN = 160, NS_W = WSPAN / NK;

struct Split {
    const half* q; long q_bs;              // q [R, 64, 512] rows at r * q_bs
    const half* kv; long kv_bs;            // kv rows of this call [*, 512] at row * kv_bs
    const half* ring; long ring_ss; int paged;   // contiguous [slots, rows, 512] or paged [pages * 256, 512]
    const half* pool_c; const half* pool_r; int D_c, D_r, epp;
    const int* bt; int npr;                // block table [jobs, npr]
    const int* idx; int kpad;              // indices [*, kpad]
    const int* meta;
    float* ws_ml; float* ws_acc; int NS; float scale;
    sycl::local_accessor<half, 1> kv_s;    // [NK * 512]
    sycl::local_accessor<float, 1> sc_s;   // [64 * NK]
    sycl::local_accessor<int, 1> ok_s;     // [NK]

    [[sycl::reqd_sub_group_size(16)]] void operator()(sycl::nd_item<2> it) const {
        int r = it.get_group(0), s = it.get_group(1);
        int t = it.get_local_id(1);
        auto sg = it.get_sub_group();
        int lane = sg.get_local_linear_id(), sgi = sg.get_group_linear_id();
        const int* M = meta + r * MS;
        int floor_ = M[1], rbeg = M[2], slot = M[3], n_pool = M[5], c0 = M[6], koff = M[7], top = M[8];
        int irow = M[9], brow = M[10];
        bool win = s < NS_W;
        int j0 = win ? s * NK : (s - NS_W) * NK;
        int cnt = win ? NK : sycl::min(NK, n_pool - j0);
        long wbase = (((long)r * NS + s) * NH);
        if (cnt <= 0 || (win && top - j0 < floor_)) {
            if (t < NH) { ws_ml[(wbase + t) * 2] = NEG; ws_ml[(wbase + t) * 2 + 1] = 0.f; }
            return;
        }
        for (int u = t; u < NK * 64; u += 256) {
            int j = u >> 6, v = u & 63;
            const half* src = nullptr;
            bool ok = false;
            if (j < cnt) {
                if (win) {
                    int a = top - (j0 + j);
                    if (a >= floor_ && a >= 0) {
                        ok = true;
                        if (a >= c0) src = kv + (long)(a + koff) * kv_bs;
                        else if (paged) src = ring + ((long)bt[(long)brow * npr + a / 256] * 256 + a % 256) * HD;
                        else src = ring + slot * ring_ss + (long)(a - rbeg) * HD;
                        src += v * 8;
                    }
                } else {
                    int e = idx[(long)irow * kpad + j0 + j];
                    if (e >= 0) {
                        ok = true;
                        long tok = (long)bt[(long)brow * npr + e / epp] * epp + e % epp;
                        int c = v * 8;
                        src = c < D_c ? pool_c + tok * D_c + c : pool_r + tok * D_r + (c - D_c);
                    }
                }
            }
            sycl::vec<half, 8> val(half(0.f));
            if (ok) val = *reinterpret_cast<const sycl::vec<half, 8>*>(src);
            *reinterpret_cast<sycl::vec<half, 8>*>(&kv_s[j * HD + v * 8]) = val;
            if (v == 0) ok_s[j] = ok;
        }
        it.barrier(sycl::access::fence_space::local_space);
        for (int hp = 0; hp < 2; ++hp) {
            float qv[2][32];
#pragma unroll
            for (int hh = 0; hh < 2; ++hh) {
                const half* qp = q + r * q_bs + (long)(sgi * 4 + hp * 2 + hh) * HD + lane * 32;
#pragma unroll
                for (int c = 0; c < 4; ++c) {
                    sycl::vec<half, 8> a = *reinterpret_cast<const sycl::vec<half, 8>*>(qp + c * 8);
#pragma unroll
                    for (int i = 0; i < 8; ++i) qv[hh][c * 8 + i] = (float)a[i];
                }
            }
            for (int j = 0; j < NK; ++j) {
                float d[2] = {0.f, 0.f};
                if (ok_s[j]) {
                    const half* kp = &kv_s[j * HD + lane * 32];
#pragma unroll
                    for (int c = 0; c < 4; ++c) {
                        sycl::vec<half, 8> a = *reinterpret_cast<const sycl::vec<half, 8>*>(kp + c * 8);
#pragma unroll
                        for (int i = 0; i < 8; ++i) {
                            float kf = (float)a[i];
                            d[0] += qv[0][c * 8 + i] * kf;
                            d[1] += qv[1][c * 8 + i] * kf;
                        }
                    }
                }
#pragma unroll
                for (int hh = 0; hh < 2; ++hh) {
                    float rr = sycl::reduce_over_group(sg, d[hh], sycl::plus<float>());
                    if (lane == 0) sc_s[(sgi * 4 + hp * 2 + hh) * NK + j] = ok_s[j] ? rr * scale : NEG;
                }
            }
        }
        sycl::group_barrier(sg);
        float pr[4][2];
#pragma unroll
        for (int hh = 0; hh < 4; ++hh) {
            int h = sgi * 4 + hh;
            float a = sc_s[h * NK + lane], c = sc_s[h * NK + lane + 16];
            float m = sycl::reduce_over_group(sg, sycl::fmax(a, c), sycl::maximum<float>());
            float pa = m <= NEG ? 0.f : sycl::exp(a - m), pc = m <= NEG ? 0.f : sycl::exp(c - m);
            float l = sycl::reduce_over_group(sg, pa + pc, sycl::plus<float>());
            pr[hh][0] = pa; pr[hh][1] = pc;
            if (lane == 0) { ws_ml[(wbase + h) * 2] = m; ws_ml[(wbase + h) * 2 + 1] = l; }
        }
        for (int hp = 0; hp < 2; ++hp) {
            float acc[2][32];
#pragma unroll
            for (int hh = 0; hh < 2; ++hh)
#pragma unroll
                for (int i = 0; i < 32; ++i) acc[hh][i] = 0.f;
            for (int j = 0; j < NK; ++j) {
                if (!ok_s[j]) continue;
                float p0 = sycl::select_from_group(sg, hp ? pr[2][j >> 4] : pr[0][j >> 4], j & 15);
                float p1 = sycl::select_from_group(sg, hp ? pr[3][j >> 4] : pr[1][j >> 4], j & 15);
                const half* kp = &kv_s[j * HD + lane * 32];
#pragma unroll
                for (int c = 0; c < 4; ++c) {
                    sycl::vec<half, 8> a = *reinterpret_cast<const sycl::vec<half, 8>*>(kp + c * 8);
#pragma unroll
                    for (int i = 0; i < 8; ++i) {
                        float kf = (float)a[i];
                        acc[0][c * 8 + i] += p0 * kf;
                        acc[1][c * 8 + i] += p1 * kf;
                    }
                }
            }
#pragma unroll
            for (int hh = 0; hh < 2; ++hh) {
                float* ap = ws_acc + (wbase + sgi * 4 + hp * 2 + hh) * HD + lane * 32;
#pragma unroll
                for (int c = 0; c < 8; ++c)
                    *reinterpret_cast<sycl::vec<float, 4>*>(ap + c * 4) =
                        sycl::vec<float, 4>(acc[hh][c * 4], acc[hh][c * 4 + 1], acc[hh][c * 4 + 2], acc[hh][c * 4 + 3]);
            }
        }
    }
};

struct Combine {
    const float* ws_ml; const float* ws_acc; const float* sinks; const float* derot; const int* meta;
    half* out; int R, NS, D_c, hpg;
    const half* kv; long kv_bs; half* ring; long ring_ss;
    void operator()(sycl::nd_item<1> it) const {
        int g = it.get_group(0);
        int r = g / NH, h = g % NH;
        int t = it.get_local_id(0);             // 128 threads x 4 dims
        const int* M = meta + r * MS;
        float m_run = sinks ? sinks[h] : NEG, l_run = sinks ? 1.f : 0.f;
        float a[4] = {0.f, 0.f, 0.f, 0.f};
        long wb = (long)r * NS * NH;
        for (int s = 0; s < NS; ++s) {
            long w = wb + (long)s * NH + h;
            float ms = ws_ml[w * 2], ls = ws_ml[w * 2 + 1];
            if (ls == 0.f) continue;
            float mn = sycl::fmax(m_run, ms);
            float al = m_run <= NEG ? 0.f : sycl::exp(m_run - mn);
            float be = sycl::exp(ms - mn);
            sycl::vec<float, 4> v = *reinterpret_cast<const sycl::vec<float, 4>*>(ws_acc + w * HD + t * 4);
#pragma unroll
            for (int i = 0; i < 4; ++i) a[i] = a[i] * al + v[i] * be;
            l_run = l_run * al + ls * be;
            m_run = mn;
        }
        float inv = l_run == 0.f ? 1.f : 1.f / l_run;
        int c0 = t * 4;
        float o[4];
#pragma unroll
        for (int i = 0; i < 4; ++i) o[i] = a[i] * inv;
        if (derot && c0 >= D_c) {
            float qp = (float)M[0];
#pragma unroll
            for (int pi = 0; pi < 2; ++pi) {
                float th = derot[(c0 + 2 * pi - D_c) / 2] * qp;
                float cs = sycl::cos(th), sn = sycl::sin(th);
                float e = o[2 * pi], od = o[2 * pi + 1];
                o[2 * pi] = e * cs - od * sn;
                o[2 * pi + 1] = od * cs + e * sn;
            }
        }
        half* op = out + (long)(h / hpg) * ((long)R * hpg * HD) + (long)r * hpg * HD + (long)(h % hpg) * HD + c0;
        *reinterpret_cast<sycl::vec<half, 4>*>(op) = sycl::vec<half, 4>((half)o[0], (half)o[1], (half)o[2], (half)o[3]);
        if (h == 0 && ring && M[4] >= 0) {
            half* rp = ring + M[3] * ring_ss + (long)M[4] * HD + c0;
            *reinterpret_cast<sycl::vec<half, 4>*>(rp) =
                *reinterpret_cast<const sycl::vec<half, 4>*>(kv + (long)(M[0] + M[7]) * kv_bs + c0);
        }
    }
};

// q [R, 64, 512] fp16 view (row stride, head stride 512), kv [*, 512] fp16 view (row stride), ring: contiguous
// [slots, rows, 512] (paged = 0) or paged [pages, 256, 512] (paged = 1, read only), pool_c [*, D_c] / pool_r [*, D_r]
// fp16 (or empty), bt [jobs, npr] int32, idx [*, kpad] int32, meta [R, 12] int32, sinks [64] f32 or None, derot
// [D_r / 2] f32 or None, out [64 / hpg, R, hpg * 512] fp16, ws_ml [R * NS * 64 * 2] f32, ws_acc [R * NS * 64 * 512] f32.
// write_ring: append each row's kv at meta wrow (contiguous ring only).
void attn_decode(at::Tensor q, at::Tensor kv, at::Tensor ring, at::Tensor pool_c, at::Tensor pool_r, at::Tensor bt,
                 at::Tensor idx, at::Tensor meta, c10::optional<at::Tensor> sinks, c10::optional<at::Tensor> derot,
                 at::Tensor out, at::Tensor ws_ml, at::Tensor ws_acc, int64_t epp, double scale, int64_t hpg,
                 bool write_ring, int64_t paged) {
    int R = q.size(0);
    TORCH_CHECK(q.size(1) == NH && q.size(2) == HD && q.stride(2) == 1 && q.stride(1) == HD);
    TORCH_CHECK(kv.size(-1) == HD && kv.stride(-1) == 1 && ring.size(-1) == HD && ring.is_contiguous());
    TORCH_CHECK(meta.is_contiguous() && meta.numel() >= (long)R * MS && idx.is_contiguous() && bt.is_contiguous());
    TORCH_CHECK(out.is_contiguous() && out.size(1) == R && out.size(2) == hpg * HD);
    TORCH_CHECK(!(paged && write_ring));
    int kpad = idx.size(1);
    int NS = NS_W + (kpad + NK - 1) / NK;
    TORCH_CHECK(ws_ml.numel() >= (long)R * NS * NH * 2 && ws_acc.numel() >= (long)R * NS * NH * HD);
    int D_c = pool_c.numel() ? pool_c.size(-1) : HD - 64, D_r = pool_r.numel() ? pool_r.size(-1) : 64;
    TORCH_CHECK(D_c + D_r == HD && D_c % 8 == 0);
    auto& qq = c10::xpu::getCurrentXPUStream(q.device().index()).queue();
    const half* qp = reinterpret_cast<const half*>(q.data_ptr());
    const half* kvp = reinterpret_cast<const half*>(kv.data_ptr());
    half* rp = reinterpret_cast<half*>(ring.data_ptr());
    const half* pc = pool_c.numel() ? reinterpret_cast<const half*>(pool_c.data_ptr()) : nullptr;
    const half* pr = pool_r.numel() ? reinterpret_cast<const half*>(pool_r.data_ptr()) : nullptr;
    long q_bs = q.stride(0), kv_bs = kv.stride(0), ring_ss = paged ? 0 : ring.stride(0);
    int npr = bt.size(1);
    const int* btp = bt.data_ptr<int>(); const int* ip = idx.data_ptr<int>(); const int* mp = meta.data_ptr<int>();
    float* wml = ws_ml.data_ptr<float>(); float* wacc = ws_acc.data_ptr<float>();
    qq.submit([&](sycl::handler& h) {
        sycl::local_accessor<half, 1> kv_s(sycl::range<1>(NK * HD), h);
        sycl::local_accessor<float, 1> sc_s(sycl::range<1>(NH * NK), h);
        sycl::local_accessor<int, 1> ok_s(sycl::range<1>(NK), h);
        Split k{qp, q_bs, kvp, kv_bs, rp, ring_ss, (int)paged, pc, pr, D_c, D_r, (int)epp, btp, npr, ip, kpad, mp,
                wml, wacc, NS, (float)scale, kv_s, sc_s, ok_s};
        h.parallel_for(sycl::nd_range<2>(sycl::range<2>(R, NS * 256), sycl::range<2>(1, 256)), k);
    });
    Combine c{wml, wacc, sinks.has_value() ? sinks->data_ptr<float>() : nullptr,
              derot.has_value() ? derot->data_ptr<float>() : nullptr, mp,
              reinterpret_cast<half*>(out.data_ptr()), R, NS, D_c, (int)hpg, kvp, kv_bs,
              write_ring ? rp : nullptr, ring_ss};
    qq.parallel_for(sycl::nd_range<1>(sycl::range<1>(R * NH * 128), sycl::range<1>(128)), c);
}

// ------------------------------------------------------------------------------------------------ small decode ops

// y[r, :] = x[r, :] * rsqrt(mean(x^2) + eps) * (w + cbias) (w optional, fp16/bf16), x fp16/fp32, y fp16/fp32 rows with
// any row stride (unit column stride). One work-group of 256 per row.
template <typename TX, typename TY>
struct Norm {
    const TX* x; long xs; TY* y; long ys; const void* w; int wbf; int D; float eps, cbias;
    void operator()(sycl::nd_item<1> it) const {
        int r = it.get_group(0), t = it.get_local_id(0), T = it.get_local_range(0);
        const TX* xr = x + r * xs;
        float ss = 0.f;
        for (int d = t; d < D; d += T) { float v = (float)xr[d]; ss += v * v; }
        ss = sycl::reduce_over_group(it.get_group(), ss, sycl::plus<float>());
        float rm = sycl::rsqrt(ss / D + eps);
        for (int d = t; d < D; d += T) {
            float v = (float)xr[d] * rm;
            if (w) v *= (wbf ? (float)sycl::bit_cast<sycl::ext::oneapi::bfloat16>(((const uint16_t*)w)[d])
                             : (float)((const half*)w)[d]) + cbias;
            y[r * ys + d] = (TY)v;
        }
    }
};

void rms_norm(at::Tensor x, c10::optional<at::Tensor> w, at::Tensor y, double eps, double cbias) {
    int D = x.size(-1);
    TORCH_CHECK(x.stride(-1) == 1 && y.stride(-1) == 1 && x.dim() == 2 && y.dim() == 2);
    int R = x.size(0);
    auto& qq = c10::xpu::getCurrentXPUStream(x.device().index()).queue();
    const void* wp = w.has_value() ? w->data_ptr() : nullptr;
    int wbf = w.has_value() && w->scalar_type() == at::kBFloat16;
    sycl::nd_range<1> nr(sycl::range<1>(R * 256), sycl::range<1>(256));
    auto go = [&](auto* xp, auto* yp) {
        using TX = std::remove_const_t<std::remove_pointer_t<decltype(xp)>>;
        using TY = std::remove_pointer_t<decltype(yp)>;
        Norm<TX, TY> k{xp, x.stride(0), yp, y.stride(0), wp, wbf, D, (float)eps, (float)cbias};
        qq.parallel_for(nr, k);
    };
    bool xh = x.scalar_type() == at::kHalf, yh = y.scalar_type() == at::kHalf;
    TORCH_CHECK((xh || x.scalar_type() == at::kFloat) && (yh || y.scalar_type() == at::kFloat));
    if (xh && yh) go(reinterpret_cast<const half*>(x.data_ptr()), reinterpret_cast<half*>(y.data_ptr()));
    else if (xh) go(reinterpret_cast<const half*>(x.data_ptr()), y.data_ptr<float>());
    else if (yh) go(x.data_ptr<float>(), reinterpret_cast<half*>(y.data_ptr()));
    else go(x.data_ptr<float>(), y.data_ptr<float>());
}

// z[r, i] = min(silu(gu[r, i]), L) * clamp(gu[r, I + i], -L, L)  (gu = gate | up rows, fp16; z fp16)
void silu_mul(at::Tensor gu, at::Tensor z, double L) {
    int R = gu.size(0), I = z.size(1);
    TORCH_CHECK(gu.size(1) == 2 * I && gu.is_contiguous() && z.is_contiguous() && gu.scalar_type() == at::kHalf);
    const half* g = reinterpret_cast<const half*>(gu.data_ptr());
    half* zp = reinterpret_cast<half*>(z.data_ptr());
    float lim = (float)L;
    auto& qq = c10::xpu::getCurrentXPUStream(gu.device().index()).queue();
    qq.parallel_for(sycl::range<1>((size_t)R * I), [=](sycl::id<1> id) {
        int r = id[0] / I, i = id[0] % I;
        float a = (float)g[(long)r * 2 * I + i], u = (float)g[(long)r * 2 * I + I + i];
        float s = a / (1.f + sycl::exp(-a));
        if (lim > 0.f) { s = sycl::fmin(s, lim); u = sycl::fmin(sycl::fmax(u, -lim), lim); }
        zp[id[0]] = (half)(s * u);
    });
}

// x[r, h, :] = post[r, h] * y[r, :] + sum_g comb[r, g, h] * x[r, g, :]  (in place; x fp32 [R, 4, D], y fp32/fp16)
void hc_apply(at::Tensor x, at::Tensor y, at::Tensor post, at::Tensor comb) {
    int R = x.size(0), D = x.size(-1);
    TORCH_CHECK(x.is_contiguous() && x.size(1) == 4 && y.is_contiguous() && post.is_contiguous() && comb.is_contiguous());
    float* xp = x.data_ptr<float>();
    const float* pp = post.data_ptr<float>(); const float* cp = comb.data_ptr<float>();
    bool yh = y.scalar_type() == at::kHalf;
    const void* yp = y.data_ptr();
    auto& qq = c10::xpu::getCurrentXPUStream(x.device().index()).queue();
    qq.parallel_for(sycl::range<1>((size_t)R * D), [=](sycl::id<1> id) {
        int r = id[0] / D, d = id[0] % D;
        float* xr = xp + (long)r * 4 * D + d;
        float yv = yh ? (float)((const half*)yp)[id[0]] : ((const float*)yp)[id[0]];
        float x0 = xr[0], x1 = xr[D], x2 = xr[2 * D], x3 = xr[3 * D];
        const float* c = cp + r * 16;
        const float* p = pp + r * 4;
#pragma unroll
        for (int h = 0; h < 4; ++h)
            xr[h * D] = p[h] * yv + c[h] * x0 + c[4 + h] * x1 + c[8 + h] * x2 + c[12 + h] * x3;
    });
}

// ------------------------------------------------------------------------------------------------ compressor (decode)

// DSV41Attention._compress_into_pool for one token per job, on the device (graph-capturable: the position, slot and
// pool page come from meta / the block table). proj [B, P] fp32: kv row at 0, gate row at hd (ratio 2). Ratio 2,
// even position: park kv / gate in the pending rows. Otherwise pool the group (softmax-gated sum for ratio 2), RMS
// norm (fp16), rope the trailing rope dims at the group's first position, write pool_c / pool_r, and (index-key
// owners) k = rms_norm(latent @ wk) roped -> pool_idx. One work-group of 512 per job.
struct Compress {
    const float* proj; int P; float* pend_kv; float* pend_g; long pend_ss; const void* nw; int nw_bf; float neps;
    const void* wk; int wk_bf; const void* kw; int kw_bf; float keps; const float* inv_freq;
    half* pool_c; half* pool_r; half* pool_idx; int D_c, D_r, Di, epp; const int* bt; int npr; const int* meta;
    int m; int rows, row; sycl::local_accessor<float, 1> sm;     // [512 lat + 128 k + 32 red]
    static float ld(const void* p, int bf, int i) {
        return bf ? (float)sycl::bit_cast<sycl::ext::oneapi::bfloat16>(((const uint16_t*)p)[i])
                  : (float)((const half*)p)[i];
    }
    void operator()(sycl::nd_item<1> it) const {
        int b = it.get_group(0), c = it.get_local_id(0);
        auto g = it.get_group();
        const int* M = meta + (b * rows + row) * MS;
        int pos = M[0], slot = M[3];
        const float* pr = proj + ((long)b * rows + row) * P;
        float kv = pr[c];
        if (m == 2 && (pos & 1) == 0) {
            pend_kv[slot * pend_ss + c] = kv;
            pend_g[slot * pend_ss + c] = pr[HD + c];
            return;
        }
        float comp = kv;
        if (m == 2) {
            float k0 = pend_kv[slot * pend_ss + c], g0 = pend_g[slot * pend_ss + c], g1 = pr[HD + c];
            float mx = sycl::fmax(g0, g1), e0 = sycl::exp(g0 - mx), e1 = sycl::exp(g1 - mx);
            comp = (k0 * e0 + kv * e1) / (e0 + e1);
        }
        float h = (float)(half)comp;
        float ss = sycl::reduce_over_group(g, h * h, sycl::plus<float>());
        float lat = (float)(half)(h * sycl::rsqrt(ss / HD + neps) * ld(nw, nw_bf, c));
        float* L = &sm[0];
        L[c] = lat;
        sycl::group_barrier(g);
        int gq = pos / m;
        long tok = (long)bt[(long)b * npr + gq / epp] * epp + gq % epp;
        float gpos = (float)(gq * m);
        // rope of the trailing D_r dims (GPT-J pairs) at gpos
        float out = lat;
        if (c >= D_c) {
            int q = (c - D_c) >> 1;
            float th = gpos * inv_freq[q], cs = sycl::cos(th), sn = sycl::sin(th);
            float o = L[c ^ 1];
            out = (c & 1) == 0 ? lat * cs - o * sn : lat * cs + o * sn;
            pool_r[tok * D_r + (c - D_c)] = (half)out;
        } else {
            pool_c[tok * D_c + c] = (half)lat;
        }
        if (!pool_idx) return;
        // index key: k = latent @ wk ([HD, Di] in x out), fp16, RMS norm, rope of the trailing D_r dims
        float* K = &sm[HD];
        if (c < Di) {
            float a = 0.f;
            for (int i = 0; i < HD; ++i) a += L[i] * ld(wk, wk_bf, i * Di + c);
            K[c] = (float)(half)a;
        }
        sycl::group_barrier(g);
        float kk = c < Di ? K[c] : 0.f;
        float ks = sycl::reduce_over_group(g, kk * kk, sycl::plus<float>());
        float kn = (float)(half)(kk * sycl::rsqrt(ks / Di + keps) * (c < Di ? ld(kw, kw_bf, c) : 0.f));
        sycl::group_barrier(g);
        if (c < Di) K[c] = kn;
        sycl::group_barrier(g);
        if (c < Di) {
            float o = kn;
            if (c >= Di - D_r) {
                int q = (c - (Di - D_r)) >> 1;
                float th = gpos * inv_freq[q], cs = sycl::cos(th), sn = sycl::sin(th);
                float ot = K[c ^ 1];
                o = (c & 1) == 0 ? kn * cs - ot * sn : kn * cs + ot * sn;
            }
            pool_idx[tok * Di + c] = (half)o;
        }
    }
};

void compress41(at::Tensor proj, c10::optional<at::Tensor> pend_kv, c10::optional<at::Tensor> pend_g, at::Tensor nw,
                double neps, c10::optional<at::Tensor> wk, c10::optional<at::Tensor> kw, double keps, at::Tensor inv_freq,
                at::Tensor pool_c, at::Tensor pool_r, c10::optional<at::Tensor> pool_idx, at::Tensor bt, at::Tensor meta,
                int64_t m, int64_t epp, int64_t rows, int64_t row) {
    int B = proj.size(0) / rows;
    TORCH_CHECK(proj.scalar_type() == at::kFloat && proj.is_contiguous() && bt.is_contiguous() && meta.is_contiguous());
    TORCH_CHECK(m == 1 || (pend_kv.has_value() && pend_g.has_value()));
    int D_c = pool_c.size(-1), D_r = pool_r.size(-1), Di = pool_idx.has_value() ? pool_idx->size(-1) : 0;
    TORCH_CHECK(D_c + D_r == HD && Di <= 512);
    auto bf = [](const at::Tensor& t) { return (int)(t.scalar_type() == at::kBFloat16); };
    auto& qq = c10::xpu::getCurrentXPUStream(proj.device().index()).queue();
    Compress k{proj.data_ptr<float>(), (int)proj.size(1),
               m == 2 ? pend_kv->data_ptr<float>() : nullptr, m == 2 ? pend_g->data_ptr<float>() : nullptr,
               m == 2 ? pend_kv->stride(0) : 0, nw.data_ptr(), bf(nw), (float)neps,
               wk.has_value() ? wk->data_ptr() : nullptr, wk.has_value() ? bf(*wk) : 0,
               kw.has_value() ? kw->data_ptr() : nullptr, kw.has_value() ? bf(*kw) : 0, (float)keps,
               inv_freq.data_ptr<float>(), reinterpret_cast<half*>(pool_c.data_ptr()),
               reinterpret_cast<half*>(pool_r.data_ptr()),
               pool_idx.has_value() ? reinterpret_cast<half*>(pool_idx->data_ptr()) : nullptr, D_c, D_r, Di, (int)epp,
               bt.data_ptr<int>(), (int)bt.size(1), meta.data_ptr<int>(), (int)m, (int)rows, (int)row,
               sycl::local_accessor<float, 1>()};
    qq.submit([&](sycl::handler& h) {
        k.sm = sycl::local_accessor<float, 1>(sycl::range<1>(HD + 512 + 32), h);
        h.parallel_for(sycl::nd_range<1>(sycl::range<1>(B * HD), sycl::range<1>(HD)), k);
    });
}

// DSpark drafter main-kv rows: rows [bsz, s, W] fp16 -> kv [pages, 256, W] at positions seqlens[r] + j through the
// job's block-table row (page = bt[r][p / 256], slot p % 256). One work-group (W / 8 threads, 8 halves each) per row.
void dspark_write_rows(at::Tensor rows, at::Tensor kv, at::Tensor bt, at::Tensor seqlens) {
    TORCH_CHECK(rows.is_contiguous() && kv.is_contiguous() && bt.is_contiguous() && rows.dim() == 3);
    int B = rows.size(0), S = rows.size(1), W = rows.size(2), npr = bt.size(1), P = kv.size(1);
    TORCH_CHECK(W % 8 == 0 && kv.size(2) == W && P == 256);
    TORCH_CHECK(seqlens.scalar_type() == at::kInt && bt.scalar_type() == at::kInt);
    const half* rp = reinterpret_cast<const half*>(rows.data_ptr());
    half* kp = reinterpret_cast<half*>(kv.data_ptr());
    const int* btp = bt.data_ptr<int>(); const int* sl = seqlens.data_ptr<int>();
    int T = W / 8;
    auto& qq = c10::xpu::getCurrentXPUStream(rows.device().index()).queue();
    qq.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t)B * S * T), sycl::range<1>(T)), [=](sycl::nd_item<1> it) {
        int g = it.get_group(0), t = it.get_local_id(0);
        int r = g / S, j = g % S;
        int p = sl[r] + j;
        long tok = (long)btp[(long)r * npr + p / 256] * 256 + p % 256;
        *reinterpret_cast<sycl::vec<half, 8>*>(kp + tok * W + t * 8) =
            *reinterpret_cast<const sycl::vec<half, 8>*>(rp + ((long)r * S + j) * W + t * 8);
    });
}

}  // namespace dsvattn

TORCH_LIBRARY(dsv_attn, m) {
    m.def("attn_decode(Tensor q, Tensor kv, Tensor(a!) ring, Tensor pool_c, Tensor pool_r, Tensor bt, Tensor idx, "
          "Tensor meta, Tensor? sinks, Tensor? derot, Tensor(b!) out, Tensor(c!) ws_ml, Tensor(d!) ws_acc, int epp, "
          "float scale, int hpg, bool write_ring, int paged=0) -> ()");
    m.def("rms_norm(Tensor x, Tensor? w, Tensor(a!) y, float eps, float cbias) -> ()");
    m.def("silu_mul(Tensor gu, Tensor(a!) z, float L) -> ()");
    m.def("hc_apply(Tensor(a!) x, Tensor y, Tensor post, Tensor comb) -> ()");
    m.def("dspark_write_rows(Tensor rows, Tensor(a!) kv, Tensor bt, Tensor seqlens) -> ()");
    m.def("compress41(Tensor proj, Tensor(a!)? pend_kv, Tensor(b!)? pend_g, Tensor nw, float neps, Tensor? wk, "
          "Tensor? kw, float keps, Tensor inv_freq, Tensor(c!) pool_c, Tensor(d!) pool_r, Tensor(e!)? pool_idx, "
          "Tensor bt, Tensor meta, int m, int epp, int rows=1, int row=0) -> ()");
}
TORCH_LIBRARY_IMPL(dsv_attn, XPU, m) {
    m.impl("attn_decode", &dsvattn::attn_decode);
    m.impl("rms_norm", &dsvattn::rms_norm);
    m.impl("silu_mul", &dsvattn::silu_mul);
    m.impl("hc_apply", &dsvattn::hc_apply);
    m.impl("compress41", &dsvattn::compress41);
    m.impl("dspark_write_rows", &dsvattn::dspark_write_rows);
}
