+    @triton.jit
+    def merge_kernel(PO, PM, PL, O, so_r, so_h, NSPLIT, HKV: tl.constexpr, G: tl.constexpr, GP: tl.constexpr,
+                     D: tl.constexpr, SP: tl.constexpr):
+        r = tl.program_id(0)
+        hq = tl.program_id(1)
+        h = hq // G
+        g = hq % G
+        sp = tl.arange(0, SP)
+        smask = sp < NSPLIT
+        base = (r * HKV + h) * NSPLIT + sp
+        ms = tl.load(PM + base * GP + g, mask=smask, other=float("-inf"))
+        ls = tl.load(PL + base * GP + g, mask=smask, other=0.0)
+        mx = tl.max(ms, 0)
+        mx_safe = tl.where(mx == float("-inf"), 0.0, mx)
+        w = tl.where(smask, tl.exp(ms - mx_safe), 0.0)
+        den = tl.sum(w * ls, 0)
+        dims = tl.arange(0, D)
+        po = tl.load(PO + (base * GP + g)[:, None] * D + dims[None, :], mask=smask[:, None], other=0.0)
+        num = tl.sum(po * w[:, None], 0)
+        out = tl.where(den > 0, num / den, 0.0)                                     # no valid slot -> 0, like the reference
+        tl.store(O + r * so_r + hq * so_h + dims, out.to(O.dtype.element_ty))
+
+    _tl_kernels = (split_kernel, merge_kernel, triton)
+    return _tl_kernels
