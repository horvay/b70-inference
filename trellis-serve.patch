+def _union_sdpa(q, k_cache, v_cache, valid, uni, col, scale, out):
+    """The union attention through torch's fused SDPA with a boolean mask (EXL3_QSA_SDPA=1, default): the masked
+    fp32 score matrices never reach memory. At 8192 query rows over 16K keys this is 56 ms per layer against 278 ms
+    for the matmul/softmax/matmul loop, same result to bf16 rounding (tests/bench_qsa_attn.py). A row with no selected
+    key gives NaN in SDPA; the reference gives 0 for it, so NaN rows are zeroed."""
+    R, Hq, D = q.shape
+    nu = int(uni.numel())
+    kk = k_cache.index_select(0, uni.long()).to(torch.bfloat16).transpose(0, 1).unsqueeze(0)    # [1, Hk, nu, D]
+    vv = v_cache.index_select(0, uni.long()).to(torch.bfloat16).transpose(0, 1).unsqueeze(0)
+    for r0 in range(0, R, _SDPA_ROWS):
+        r1 = min(R, r0 + _SDPA_ROWS)
+        n = r1 - r0
+        mask = torch.zeros((n, nu + 1), dtype=torch.bool, device=q.device)
+        mask.scatter_(1, col[r0:r1].long(), True)
+        o = torch.nn.functional.scaled_dot_product_attention(
+            q[r0:r1].to(torch.bfloat16).transpose(0, 1).unsqueeze(0), kk, vv,
+            attn_mask=mask[:, :nu].view(1, 1, n, nu), scale=scale, enable_gqa=True)
+        out[r0:r1] = torch.nan_to_num_(o[0].transpose(0, 1), nan=0.0).to(q.dtype)
+    return out
+
