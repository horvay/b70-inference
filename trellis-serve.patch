+    merge_kernel[(R, Hq)](po, pm, pl, out, out.stride(0), out.stride(1), nsplit, HKV=Hk, G=G, GP=GP, D=D,
+                          SP=triton.next_power_of_2(nsplit), num_warps=4)
+    return out
