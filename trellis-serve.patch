new file mode 100644
index 0000000..e790b95
--- /dev/null
+++ i/xpu/tests/bench_qsa_attn.py
@@ -0,0 +1,102 @@
+"""
+QSA sparse prefill attention on the B70: the plugin's union path (exl3xpu.qsa_xpu.qsa_sparse_attention_union) against
+candidate replacements, on synthetic data at Qwen3.8-Flash-Next shapes (Hq 24, Hk 2, head_dim 256, 2048 selected
+tokens per query as 512 blocks of 4 plus the local tail). Reports time and max difference to the union output.
+
+  python3 tests/bench_qsa_attn.py --rows 8192 --keys 16384
+"""
+import argparse
+import os
+import sys
+import time
+
+import torch
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.join(HERE, ".."))
+from exl3xpu import qsa_xpu  # noqa: E402
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--rows", type=int, default=8192)
+ap.add_argument("--keys", type=int, default=16384)
+ap.add_argument("--iters", type=int, default=3)
+a = ap.parse_args()
+dev = torch.device("xpu", 0)
+Hq, Hk, D, RATIO, TOPK = 24, 2, 256, 4, 2048
+R, L = a.rows, a.keys
+g = torch.Generator(device="cpu").manual_seed(0)
+
+# paged fp8 KV pool with the sequence's tokens scattered over physical slots (like SGLang's pool)
+n_slots = L + 4096
+perm = torch.randperm(n_slots, generator=g)[:L]              # logical token -> physical slot
+k_cache = (torch.randn((n_slots, Hk, D), generator=g) * 0.5).to(torch.float8_e4m3fn).to(dev)
+v_cache = (torch.randn((n_slots, Hk, D), generator=g) * 0.5).to(torch.float8_e4m3fn).to(dev)
+q = (torch.randn((R, Hq, D), generator=g) * 0.5).to(torch.bfloat16).to(dev)
+
+# selection: query r sits at position L - R + r; it sees blocks entirely before it and picks min(512, n) of them
+# (biased towards recent ones, as the indexer tends to), plus its partial tail block
+pos = torch.arange(L - R, L)
+logical = torch.full((R, TOPK + RATIO - 1), -1, dtype=torch.long)
+for r in range(R):
+    p = int(pos[r])
+    nb = (p + 1) // RATIO
+    if nb:
+        w = torch.linspace(0.2, 1.0, nb) ** 4
+        k = min(TOPK // RATIO, nb)
+        blocks = torch.multinomial(w, k, replacement=False, generator=g).sort().values
+        toks = (blocks.unsqueeze(1) * RATIO + torch.arange(RATIO)).flatten()
+        logical[r, :toks.numel()] = toks
+        n = toks.numel()
+    else:
+        n = 0
+    tail = torch.arange(nb * RATIO, p + 1)
+    logical[r, n:n + tail.numel()] = tail
+slots = torch.where(logical >= 0, perm[logical.clamp_min(0)], torch.full_like(logical, -1)).to(torch.int32).to(dev)
+scale = D ** -0.5
+
+
+def t(fn, name, ref=None):
+    out = fn()
+    torch.xpu.synchronize()
+    t0 = time.perf_counter()
+    for _ in range(a.iters):
+        out = fn()
+    torch.xpu.synchronize()
+    ms = (time.perf_counter() - t0) / a.iters * 1e3
+    d = "" if ref is None else f"  max|diff| vs union {(out.float() - ref.float()).abs().max().item():.4f}"
+    print(f"{name:34s} {ms:8.1f} ms{d}", flush=True)
+    return out
+
+
+ref = t(lambda: qsa_xpu.qsa_sparse_attention_union(q, k_cache, v_cache, slots, scale), "union (current)")
+
+
+def sdpa_mask(block=2048):
+    """Fused SDPA over the union of selected slots with a boolean mask, GQA by head expansion, row blocks."""
+    valid = slots >= 0
+    uni = torch.unique(slots[valid])
+    nu = int(uni.numel())
+    col = torch.where(valid, torch.searchsorted(uni, slots.clamp_min(0).to(uni.dtype)),
+                      torch.full_like(slots, nu, dtype=torch.long))
+    kk = k_cache.index_select(0, uni.long()).to(torch.bfloat16).transpose(0, 1)       # [Hk, nu, D]
+    vv = v_cache.index_select(0, uni.long()).to(torch.bfloat16).transpose(0, 1)
+    out = torch.empty_like(q)
+    for r0 in range(0, R, block):
+        r1 = min(R, r0 + block)
+        n = r1 - r0
+        mask = torch.zeros((n, nu + 1), dtype=torch.bool, device=dev)
+        mask.scatter_(1, col[r0:r1].long(), True)
+        qq = q[r0:r1].transpose(0, 1).unsqueeze(0)                                       # [1, Hq, n, D]
+        o = torch.nn.functional.scaled_dot_product_attention(
+            qq, kk.unsqueeze(0), vv.unsqueeze(0), attn_mask=mask[:, :nu].view(1, 1, n, nu), scale=scale,
+            enable_gqa=True)
+        out[r0:r1] = o[0].transpose(0, 1)
+    return out
+
+
+t(lambda: qsa_xpu.qsa_sparse_attention(q, k_cache, v_cache, slots, scale), "plugin qsa_sparse_attention", ref)
+for blk in (1024, 4096):
+    try:
+        t(lambda: sdpa_mask(blk), f"sdpa bool-mask, rows/{blk}", ref)
+    except Exception as e:
+        print(f"sdpa bool-mask rows/{blk}: failed: {type(e).__name__}: {str(e)[:200]}", flush=True)
