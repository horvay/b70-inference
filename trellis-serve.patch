+    torch_fn, triton_fn = K.torch_expand_qsa_block_indices, K.triton_expand_qsa_block_indices
+
+    def expand_qsa_block_indices(block_indices, query_positions, sequence_lengths, compress_ratio, token_topk):
+        capturing = hasattr(torch.xpu, "is_current_stream_capturing") and torch.xpu.is_current_stream_capturing()
