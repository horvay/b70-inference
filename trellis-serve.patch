diff --git c/xpu/tests/test_static_tier.py i/xpu/tests/test_static_tier.py
new file mode 100644
index 0000000..958720b
--- /dev/null
+++ i/xpu/tests/test_static_tier.py
@@ -0,0 +1,138 @@
+"""
+B70 spike: the ExpertStore static tier (EXL3_MOE_STATIC) and per-K stores, on real experts of one layer.
+
+A store whose `static` experts sit in pinned device slots (no host copy) must give exactly the output of the plain
+pointer-table MoE over all-host experts, through every path the plugin uses: decode with the LRU cache
+(forward_cached), prefill staging (forward_prefill_staged) and plain forward. Static slots must never be evicted,
+and the host arena must hold only the non-static experts.
+
+  python3 tests/test_static_tier.py --model /models/<ckpt> --layer 1 --static 150 --slots 200
+  python3 tests/test_static_tier.py --model /models/<ckpt> --layer 0 --all-static        # a K=4 layer
+"""
+import argparse, json, os, sys
+import torch
+from safetensors import safe_open
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.join(HERE, ".."))
+from exl3xpu.moe_offload import ExpertStore, ops, pack_expert, s64
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--model", required=True)
+ap.add_argument("--layer", type=int, default=1)
+ap.add_argument("--static", type=int, default=150)
+ap.add_argument("--slots", type=int, default=200)
+ap.add_argument("--all-static", action="store_true")
+ap.add_argument("--steps", type=int, default=24)
+args = ap.parse_args()
+
+dev = torch.device("xpu:0")
+H, I, E, TOPK = 2560, 640, 512, 10
+idx = json.load(open(f"{args.model}/model.safetensors.index.json"))["weight_map"]
+handles = {}
+
+
+def get(name):
+    fn = idx[name]
+    if fn not in handles:
+        handles[fn] = safe_open(f"{args.model}/{fn}", "pt", device="cpu")
+    return handles[fn].get_tensor(name)
+
+
+def expert(e):
+    p = f"model.language_model.layers.{args.layer}.mlp.experts.{e}."
+    return [{s: get(p + pr + "." + s) for s in ("trellis", "suh", "svh")} for pr in ("gate_proj", "up_proj", "down_proj")]
+
+
+K = expert(0)[0]["trellis"].shape[2] // 16
+X = ops()
+BLOB = int(X.blob_bytes(H, I, K))
+n_static = E if args.all_static else args.static
+n_slots = E if args.all_static else args.slots
+print(f"layer {args.layer}: K={K}, blob {BLOB} B, {n_static} static, {n_slots} slots", flush=True)
+
+# reference: every expert in host USM, plain pointer table
+ref_host = X.host_alloc(E * BLOB).view(E, BLOB)
+for e in range(E):
+    pack_expert(*expert(e), K, out=ref_host[e])
+ref_ptrs = (s64(ref_host.data_ptr()) + torch.arange(E, dtype=torch.int64) * BLOB).to(dev)
+
+# store under test: a pseudo-random static set (not a contiguous range), packed through pack_target/pack_done
+g = torch.Generator().manual_seed(1)
+static = sorted(torch.randperm(E, generator=g)[:n_static].tolist())
+store = ExpertStore(H, I, K, E, n_slots, dev)
+key = f"layers.{args.layer}.mlp.experts"
+store.add_layer(key, static=static)
+for e in range(E):
+    pack_expert(*expert(e), K, out=store.pack_target(key, e))
+    store.pack_done(key, e)
+torch.xpu.synchronize()
+
+ok = True
+
+
+def check(name, cond):
+    global ok
+    ok &= bool(cond)
+    print(("PASS " if cond else "FAIL ") + name, flush=True)
+
+
+check(f"host arena holds only the {E - n_static} non-static experts",
+      store.host[key].shape[0] == E - n_static)
+pinned = store.slot_last.cpu()
+st_slots = [int(store.slot_of[key][e]) for e in static]
+check("every static expert has a pinned slot", all(s >= 0 and int(pinned[s]) == 0x7FFFFFFF for s in st_slots))
+for e in static[:8]:
+    s_ = int(store.slot_of[key][e])
+    if not torch.equal(store.slots[s_].cpu(), ref_host[e]):
+        check(f"static expert {e}: slot bytes equal the packed blob", False)
+        break
+else:
+    check("static experts' slot bytes equal their packed blobs (first 8)", True)
+
+
+def routing(M, seed):
+    gg = torch.Generator().manual_seed(seed)
+    w, ids = torch.topk(torch.softmax(torch.randn((M, E), generator=gg), -1), TOPK, dim=-1)
+    return ids.to(torch.int32).to(dev), (w / w.sum(-1, keepdim=True)).float().to(dev)
+
+
+dt = torch.bfloat16
+same = True
+for step in range(args.steps):                      # decode through the device LRU cache (misses write through)
+    M = 1 + step % 4
+    x = (torch.randn((M, H), generator=torch.Generator().manual_seed(100 + step)) * 0.5).to(dt).to(dev)
+    ids, w = routing(M, 200 + step)
+    y = store.forward_cached(key, x, ids, w)
+    r = X.moe_forward(x, ids, w, ref_ptrs, I, K, E)
+    same &= torch.equal(y, r)
+torch.xpu.synchronize()
+check(f"forward_cached == all-host moe_forward over {args.steps} decode steps (bit-exact)", same)
+pinned = store.slot_last.cpu()
+check("static slots still pinned after the LRU ran", all(int(pinned[s]) == 0x7FFFFFFF for s in st_slots))
+ptrs_now = store.ptrs(key).cpu()
+check("static experts still point at their slots",
+      all(int(ptrs_now[e]) == store.slot_ptr(int(store.slot_of[key][e])) for e in static))
+
+store.reserve_staging()                             # load time: staging sized to the non-static experts only
+st0 = store._stage[0]
+check(f"staging buffer holds E - static = {E - n_static} experts",
+      (st0 is None and n_static == E) or (st0 is not None and st0.shape[0] == E - n_static))
+M = 600                                             # prefill: staging path (copy engine + DPAS)
+x = (torch.randn((M, H), generator=torch.Generator().manual_seed(7)) * 0.5).to(dt).to(dev)
+ids, w = routing(M, 9)
+y = store.forward_prefill_staged(key, x, ids, w)
+r = X.moe_forward(x, ids, w, ref_ptrs, I, K, E)
+torch.xpu.synchronize()
+check(f"forward_prefill_staged == all-host moe_forward at M={M} (bit-exact)", torch.equal(y, r))
+check("prefill staging did not grow the buffer at run time", store._stage[0] is st0)
+
+store.reset_cache()                                 # reset keeps the static tier
+pinned = store.slot_last.cpu()
+check("reset_cache keeps static slots pinned", all(int(pinned[s]) == 0x7FFFFFFF for s in st_slots))
+x = (torch.randn((3, H), generator=torch.Generator().manual_seed(11)) * 0.5).to(dt).to(dev)
+ids, w = routing(3, 12)
+check("forward after reset_cache == reference",
+      torch.equal(store.forward_cached(key, x, ids, w), X.moe_forward(x, ids, w, ref_ptrs, I, K, E)))
+print("ALL PASS" if ok else "SOME FAILED", flush=True)
+sys.exit(0 if ok else 1)
