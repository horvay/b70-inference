--- /dev/null
+++ i/xpu/exl3xpu/fused_xpu.py
@@ -0,0 +1,187 @@
+"""Fused small-op kernels for Qwen3.8-Flash-Next on XPU (Triton), replacing chains of PyTorch ops that ran as separate
+kernels on the B70 (2026-10-12 eager decode profile, per token):
+
+  * router (TopK.forward_xpu, 48 layers): softmax over 512 experts, torch.topk (two radix-sort kernels), renormalise,
+    plus the cold-tier routing bias: ~19 kernels per layer, 2.8 ms. Here one kernel per layer: optional ranking bias
+    (cold experts -1e4, RAM margin for experts outside a device slot), softmax of the unbiased logits, top-k by k
+    argmax passes, weights renormalised as SGLang does (sum + 1e-20).
+  * hyper-connection norm (GroupedGemmaRMSNorm, 96 calls): fp32 casts, pow, mean, rsqrt, two muls, cast back:
+    ~10 kernels per call, 2.5 ms. Here one kernel per call, same fp32 math.
+
+  * hyper-connection combine (GatedResidual.combine, 96 calls): a oneDNN GEMM for the 4 x 10240 inject weights
+    (~15 us each) plus a compiled elementwise kernel. Here one kernel: each program recomputes the four inject dot
+    products from the normed input (L2-resident), then writes its slice of x + block_output * 2 sigmoid(dot / hc).
+
+EXL3_FUSED_ROUTER=0 / EXL3_FUSED_HCNORM=0 / EXL3_FUSED_HCCOMBINE=0 turn them off.
+"""
+from __future__ import annotations
+
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+ROUTER = os.environ.get("EXL3_FUSED_ROUTER", "1") == "1"
+HCNORM = os.environ.get("EXL3_FUSED_HCNORM", "1") == "1"
+HCCOMBINE = os.environ.get("EXL3_FUSED_HCCOMBINE", "0") == "1"   # off: 15.6 us vs SGLang 5.8 us in a graph
+
+
+@triton.jit
+def _router_kernel(logit_ptr, cold_ptr, slot_ptr, margin_ptr, w_ptr, id_ptr, E, K: tl.constexpr,
+                   HAS_BIAS: tl.constexpr, HAS_MARGIN: tl.constexpr, RENORM: tl.constexpr, BLOCK: tl.constexpr):
+    r = tl.program_id(0)
+    e = tl.arange(0, BLOCK)
+    em = e < E
+    x = tl.load(logit_ptr + r * E + e, mask=em, other=-float("inf")).to(tl.float32)
+    mx = tl.max(x, axis=0)
+    ex = tl.where(em, tl.exp(x - mx), 0.0)
+    p = ex / tl.sum(ex, axis=0)
+    score = x
+    if HAS_BIAS:
+        score = score + tl.load(cold_ptr + e, mask=em, other=0.0)
+        if HAS_MARGIN:
+            mg = tl.load(margin_ptr)
+            so = tl.load(slot_ptr + e, mask=em, other=0)
+            score = score - tl.where(so < 0, mg, 0.0)
+    score = tl.where(em, score, -float("inf"))
+    k = tl.arange(0, 16)
+    ids = tl.zeros((16,), dtype=tl.int32)
+    ws = tl.zeros((16,), dtype=tl.float32)
+    for i in tl.static_range(K):
+        j = tl.argmax(score, axis=0)
+        pj = tl.sum(tl.where(e == j, p, 0.0), axis=0)
+        ids = tl.where(k == i, j, ids)
+        ws = tl.where(k == i, pj, ws)
+        score = tl.where(e == j, -float("inf"), score)
+    if RENORM:
+        ws = ws / (tl.sum(tl.where(k < K, ws, 0.0), axis=0) + 1e-20)
+    tl.store(id_ptr + r * K + k, ids, mask=k < K)
+    tl.store(w_ptr + r * K + k, ws, mask=k < K)
+
+
+def router(logits: torch.Tensor, top_k: int, renormalize: bool, cold=None, slot_of=None, margin=None):
+    """(topk_weights fp32 [R, K], topk_ids int32 [R, K]) for softmax routing; with `cold` (fp32 [E]) the ranking uses
+    logits + cold - margin * (slot_of < 0), the weights stay the unbiased softmax."""
+    R, E = logits.shape
+    assert top_k <= 16 and E <= 1024
+    w = torch.empty((R, top_k), dtype=torch.float32, device=logits.device)
+    ids = torch.empty((R, top_k), dtype=torch.int32, device=logits.device)
+    if R == 0:
+        return w, ids
+    has_bias = cold is not None
+    has_margin = has_bias and margin is not None and slot_of is not None
+    lg = logits if logits.is_contiguous() else logits.contiguous()
+    _router_kernel[(R,)](lg, cold if has_bias else lg, slot_of if has_margin else lg, margin if has_margin else lg,
+                         w, ids, E, K=top_k, HAS_BIAS=has_bias, HAS_MARGIN=has_margin, RENORM=bool(renormalize),
+                         BLOCK=triton.next_power_of_2(E), num_warps=4)
+    return w, ids
+
+
+@triton.jit
+def _grouped_rmsnorm_kernel(x_ptr, w_ptr, y_ptr, N, G, eps, BLOCK: tl.constexpr):
+    """y[r, g*G:(g+1)*G] = x * rsqrt(mean(x^2) + eps) * (1 + w), per group, fp32 math (GroupedGemmaRMSNorm)."""
+    r = tl.program_id(0)
+    g = tl.program_id(1)
+    c = tl.arange(0, BLOCK)
+    m = c < G
+    off = r * N + g * G + c
+    x = tl.load(x_ptr + off, mask=m, other=0.0).to(tl.float32)
+    var = tl.sum(x * x, axis=0) / G
+    w = tl.load(w_ptr + g * G + c, mask=m, other=0.0).to(tl.float32)
+    y = x * (1.0 / tl.sqrt(var + eps)) * (1.0 + w)
+    tl.store(y_ptr + off, y.to(y_ptr.dtype.element_ty), mask=m)
+
+
+def grouped_rmsnorm(mod, x: torch.Tensor) -> torch.Tensor:
+    N = x.shape[-1]
+    G = mod.group_size or N
+    x2 = x.reshape(-1, N)
+    if not x2.is_contiguous():
+        x2 = x2.contiguous()
+    y = torch.empty_like(x2)
+    if x2.shape[0]:
+        _grouped_rmsnorm_kernel[(x2.shape[0], N // G)](x2, mod.weight, y, N, G, float(mod.variance_epsilon),
+                                                       BLOCK=triton.next_power_of_2(G), num_warps=8)
+    return y.view(x.shape)
+
+
+def install_hcnorm() -> bool:
+    if not HCNORM:
+        return False
+    from sglang.srt.layers import hyperconnection as hcm
+    C = hcm.GroupedGemmaRMSNorm
+    if getattr(C, "_exl3_fused", False):
+        return True
+    orig = C.forward
+
+    def forward(self, x):
+        if x.device.type == "xpu" and x.dtype in (torch.bfloat16, torch.float16) and self.weight.shape[-1] == x.shape[-1] \
+                and (self.group_size is None or x.shape[-1] % self.group_size == 0) \
+                and (self.group_size or x.shape[-1]) <= 8192:
+            return grouped_rmsnorm(self, x)
+        return orig(self, x)
+
+    C.forward = forward
+    C._exl3_fused = True
+    return True
+
+
+@triton.jit
+def _hc_combine_kernel(x_ptr, n_ptr, bo_ptr, wi_ptr, out_ptr, HD, HS, inv_hc, NS: tl.constexpr, BLOCK: tl.constexpr):
+    """out[r] = x[r] + block_output[r, col % HS] * 2 sigmoid(bf16(dot(normed[r], Wi[col // HS])) / hc)."""
+    r = tl.program_id(0)
+    sp = tl.program_id(1)
+    i4 = tl.arange(0, 4)
+    acc = tl.zeros((4, BLOCK), dtype=tl.float32)
+    for c0 in range(0, HD, BLOCK):
+        c = c0 + tl.arange(0, BLOCK)
+        m = c < HD
+        nv = tl.load(n_ptr + r * HD + c, mask=m, other=0.0).to(tl.float32)
+        wv = tl.load(wi_ptr + i4[:, None] * HD + c[None, :], mask=m[None, :], other=0.0).to(tl.float32)
+        acc += wv * nv[None, :]
+    dot = tl.sum(acc, axis=1).to(tl.bfloat16).to(tl.float32)                  # the reference's linear output is bf16
+    inj = 2.0 / (1.0 + tl.exp(-(dot * inv_hc)))                                 # (4,)
+    per = tl.cdiv(HD, NS)
+    for c0 in range(sp * per, sp * per + per, BLOCK):
+        c = c0 + tl.arange(0, BLOCK)
+        m = (c < HD) & (c < sp * per + per)
+        s_of = c // HS
+        g = tl.sum(tl.where(s_of[None, :] == i4[:, None], inj[:, None], 0.0), axis=0)
+        xv = tl.load(x_ptr + r * HD + c, mask=m, other=0.0).to(tl.float32)
+        bo = tl.load(bo_ptr + r * HS + (c - s_of * HS), mask=m, other=0.0).to(tl.float32)
+        tl.store(out_ptr + r * HD + c, (xv + bo * g).to(out_ptr.dtype.element_ty), mask=m)
+
+
+def hc_combine(gr, block_output: torch.Tensor, x: torch.Tensor, normed: torch.Tensor) -> torch.Tensor:
+    R, HD = x.shape
+    out = torch.empty_like(x)
+    if R:
+        ns = 8 if R <= 64 else 1
+        _hc_combine_kernel[(R, ns)](x, normed, block_output, gr.block_inject_weight.weight, out, HD, gr.hidden_size,
+                                    1.0 / gr.hc_count, NS=ns, BLOCK=1024, num_warps=8)
+    return out
+
+
+def install_hccombine() -> bool:
+    if not HCCOMBINE:
+        return False
+    from sglang.srt.layers import hyperconnection as hcm
+    G = hcm.GatedResidual
+    if getattr(G, "_exl3_fused_combine", False):
+        return True
+    orig = G.combine
+
+    def combine(self, block_output, residuals):
+        if isinstance(residuals, tuple) and len(residuals) == 2 and self.hc_count == 4 and hasattr(self, "block_inject_weight"):
+            x, n = residuals
+            if x.device.type == "xpu" and x.dim() == 2 and n.shape == x.shape and block_output.dim() == 2 \
+                    and x.shape[0] == block_output.shape[0] and x.shape[1] == 4 * self.hidden_size \
+                    and block_output.shape[1] == self.hidden_size and x.dtype == block_output.dtype == n.dtype \
+                    and x.is_contiguous() and n.is_contiguous() and block_output.is_contiguous():
+                return hc_combine(self, block_output, x, n)
+        return orig(self, block_output, residuals)
+
+    G.combine = combine
+    G._exl3_fused_combine = True
+    return True
