+    @triton.jit
+    def split_kernel(Q, K, V, SL, PO, PM, PL, scale, S, NSPLIT, sq_r, sq_h, sk_n, sk_h, ss_r,
+                     G: tl.constexpr, GP: tl.constexpr, D: tl.constexpr, BLOCK_SPLIT: tl.constexpr, BN: tl.constexpr):
+        r = tl.program_id(0)
+        h = tl.program_id(1)
+        sp = tl.program_id(2)
+        rows = tl.arange(0, GP)
+        dims = tl.arange(0, D)
+        qmask = rows < G
+        q = tl.load(Q + r * sq_r + (h * G + rows)[:, None] * sq_h + dims[None, :], mask=qmask[:, None], other=0.0)
+        q = q.to(tl.bfloat16)
+        m = tl.full([GP], float("-inf"), tl.float32)
+        l = tl.zeros([GP], tl.float32)
+        acc = tl.zeros([GP, D], tl.float32)
+        lo = sp * BLOCK_SPLIT
+        for n0 in range(0, BLOCK_SPLIT, BN):
+            cols = lo + n0 + tl.arange(0, BN)
+            slot = tl.load(SL + r * ss_r + cols, mask=cols < S, other=-1).to(tl.int64)
+            kmask = slot >= 0
+            off = tl.where(kmask, slot, 0)[:, None] * sk_n + h * sk_h + dims[None, :]
+            k = tl.load(K + off, mask=kmask[:, None], other=0.0).to(tl.bfloat16)
+            v = tl.load(V + off, mask=kmask[:, None], other=0.0).to(tl.bfloat16)
+            sc = tl.dot(q, tl.trans(k)).to(tl.bfloat16).to(tl.float32) * scale     # the reference's bf16 einsum
+            sc = tl.where(kmask[None, :], sc, float("-inf"))
