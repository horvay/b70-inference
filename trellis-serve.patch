@@ -0,0 +1,208 @@
+"""Fused hyper-connection (SGLang GatedResidual, Qwen3.8-Flash-Next: 4 streams x 2560, low rank 320, per-stream Gemma
+RMSNorm) for small row counts (decode, MTP verify) on XPU.
+
+SGLang's fast paths are CUDA-only; on XPU every mix/combine ran the eager norm (pow/mean/rsqrt/mul/cast) plus two
+torch.compile'd regions with three oneDNN GEMMs: ~12 kernels per call, 96 calls per token, ~8 ms of a 29 ms decode step.
+Here a call is three Triton kernels and each weight is read once:
+
+  k1 (grid: column chunks x low-rank blocks): partial dot products of the down projection and the inject weights with
+     y = x * (1 + w_norm), per chunk, plus the per-chunk sums of squares. The RMSNorm scale rs[stream] is constant over
+     a stream's columns, so it is applied when the partials are summed: normed = x * rs * (1 + w).
+  k2 (grid: blocks of the 2560 columns): rs per stream, t = silu(sum_c rs * pd / hc), u = sigmoid(W_up t),
+     out = mean_s(u * normed)   -> mixed input (bf16); also stores rs for the combine.
+  k3 (grid: blocks of the 10240 columns): inj = 2 sigmoid(sum_c rs * pi / hc), out = x + block_output * inj[stream].
+
+Numerics: fp32 throughout with bf16 rounding of normed and t (as the reference rounds them), so results match the
+reference within bf16 rounding, not bit for bit. EXL3_HC_FUSED=0 turns it off; rows above EXL3_HC_FUSED_ROWS (16) use
+SGLang's path. Off by default: 684 us per call in a graph against 41 us for SGLang's path (2026-10-12); kept for reference.
+"""
+from __future__ import annotations
+
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+MAX_ROWS = int(os.environ.get("EXL3_HC_FUSED_ROWS", "16"))
+_CH = 512          # columns per k1 chunk (a stream of 2560 is 5 chunks)
+_LB = 64           # low-rank rows per k1 program
+_SUB = 128         # k1 inner column step
+_DB = 64           # k2 output columns per program
+_K3B = 1024        # k3 columns per program
+
+
+@triton.jit
+def _hc_k1(x_ptr, wn_ptr, wd_ptr, wi_ptr, pd_ptr, pi_ptr, ss_ptr, R, HD, L, NC,
+           HAS_INJ: tl.constexpr, CH: tl.constexpr, LB: tl.constexpr, SUB: tl.constexpr, RP: tl.constexpr):
+    c = tl.program_id(0)
+    j = tl.program_id(1)
+    r = tl.arange(0, RP)
+    rm = r < R
+    lr = j * LB + tl.arange(0, LB)
+    lm = lr < L
+    acc = tl.zeros((RP, LB), dtype=tl.float32)
+    ss = tl.zeros((RP,), dtype=tl.float32)
+    i16 = tl.arange(0, 16)
+    acc_i = tl.zeros((RP, 16), dtype=tl.float32)
+    for k0 in range(0, CH, SUB):
+        cols = c * CH + k0 + tl.arange(0, SUB)
+        xv = tl.load(x_ptr + r[:, None] * HD + cols[None, :], mask=rm[:, None], other=0.0).to(tl.float32)
+        wn = 1.0 + tl.load(wn_ptr + cols).to(tl.float32)
+        y = xv * wn[None, :]
+        yb = y.to(tl.bfloat16)
+        w = tl.load(wd_ptr + lr[:, None] * HD + cols[None, :], mask=lm[:, None], other=0.0)
+        acc += tl.dot(yb, tl.trans(w))
+        if j == 0:
+            ss += tl.sum(xv * xv, axis=1)
+            if HAS_INJ:
+                wi = tl.load(wi_ptr + i16[:, None] * HD + cols[None, :], mask=(i16 < 4)[:, None], other=0.0)
+                acc_i += tl.dot(yb, tl.trans(wi))
+    tl.store(pd_ptr + (r[:, None] * NC + c) * L + lr[None, :], acc, mask=rm[:, None] & lm[None, :])
+    if j == 0:
+        tl.store(ss_ptr + r * NC + c, ss, mask=rm)
+        if HAS_INJ:
+            tl.store(pi_ptr + (r[:, None] * NC + c) * 4 + i16[None, :], acc_i, mask=rm[:, None] & (i16 < 4)[None, :])
+
+
+@triton.jit
+def _hc_k2(x_ptr, wn_ptr, wu_ptr, pd_ptr, ss_ptr, rs_ptr, out_ptr, R, HS, L, NC, CPS, eps, inv_hc,
+           RP: tl.constexpr, LP: tl.constexpr, NCP: tl.constexpr, DB: tl.constexpr):
+    pid = tl.program_id(0)
+    HD = 4 * HS
+    r = tl.arange(0, RP)
+    rm = r < R
+    # per-stream RMS scale from the chunk sums of squares
+    ci = tl.arange(0, NCP)
+    ssv = tl.load(ss_ptr + r[:, None] * NC + ci[None, :], mask=rm[:, None] & (ci < NC)[None, :], other=0.0)  # (RP, NCP)
+    st = ci // CPS                                                                                          # stream of chunk
+    i4 = tl.arange(0, 4)
+    rs = tl.zeros((RP, 4), dtype=tl.float32)
+    for s in tl.static_range(4):
+        tot = tl.sum(tl.where((st == s)[None, :], ssv, 0.0), axis=1)                                       # (RP,)
+        rs = tl.where(i4[None, :] == s, (1.0 / tl.sqrt(tot / HS + eps))[:, None], rs)
+    if pid == 0:
+        tl.store(rs_ptr + r[:, None] * 4 + i4[None, :], rs, mask=rm[:, None])
+    # t = silu(sum_c rs[stream(c)] * pd[c] / hc), rounded to bf16 like the reference's linear output
+    l = tl.arange(0, LP)
+    lm = l < L
+    t = tl.zeros((RP, LP), dtype=tl.float32)
+    for c in range(0, NC):
+        s_c = c // CPS
+        rsc = tl.sum(tl.where(i4[None, :] == s_c, rs, 0.0), axis=1)                                        # (RP,)
+        p = tl.load(pd_ptr + (r[:, None] * NC + c) * L + l[None, :], mask=rm[:, None] & lm[None, :], other=0.0)
+        t += p * rsc[:, None]
+    t = t * inv_hc
+    t = tl.where(lm[None, :], t / (1.0 + tl.exp(-t)), 0.0).to(tl.bfloat16)
+    d = pid * DB + tl.arange(0, DB)
+    acc = tl.zeros((RP, DB), dtype=tl.float32)
+    for s in tl.static_range(4):
+        rows = s * HS + d
+        w = tl.load(wu_ptr + rows[:, None] * L + l[None, :], mask=lm[None, :], other=0.0)                 # (DB, LP)
+        u = tl.dot(t, tl.trans(w))                                                                           # (RP, DB)
+        u = (1.0 / (1.0 + tl.exp(-u.to(tl.bfloat16).to(tl.float32))))
+        xv = tl.load(x_ptr + r[:, None] * HD + rows[None, :], mask=rm[:, None], other=0.0).to(tl.float32)
+        wn = 1.0 + tl.load(wn_ptr + rows).to(tl.float32)
+        rss = tl.sum(tl.where(i4[None, :] == s, rs, 0.0), axis=1)
+        nrm = (xv * rss[:, None] * wn[None, :]).to(tl.bfloat16).to(tl.float32)
+        acc += u * nrm
+    tl.store(out_ptr + r[:, None] * HS + d[None, :], (acc * 0.25).to(out_ptr.dtype.element_ty), mask=rm[:, None])
+
+
+@triton.jit
+def _hc_k3(x_ptr, bo_ptr, pi_ptr, rs_ptr, out_ptr, R, HS, NC, CPS, inv_hc,
+           RP: tl.constexpr, NCP: tl.constexpr, BLK: tl.constexpr):
+    pid = tl.program_id(0)
+    HD = 4 * HS
+    r = tl.arange(0, RP)
+    rm = r < R
+    i4 = tl.arange(0, 4)
+    rs = tl.load(rs_ptr + r[:, None] * 4 + i4[None, :], mask=rm[:, None], other=0.0)                       # (RP, 4)
+    inj = tl.zeros((RP, 4), dtype=tl.float32)
+    for c in range(0, NC):
+        s_c = c // CPS
+        rsc = tl.sum(tl.where(i4[None, :] == s_c, rs, 0.0), axis=1)
+        p = tl.load(pi_ptr + (r[:, None] * NC + c) * 4 + i4[None, :], mask=rm[:, None], other=0.0)
+        inj += p * rsc[:, None]
+    inj = inj * inv_hc
+    inj = 2.0 / (1.0 + tl.exp(-inj.to(tl.bfloat16).to(tl.float32)))
+    cols = pid * BLK + tl.arange(0, BLK)
+    s_of = cols // HS
+    d = cols - s_of * HS
+    xv = tl.load(x_ptr + r[:, None] * HD + cols[None, :], mask=rm[:, None], other=0.0).to(tl.float32)
+    bo = tl.load(bo_ptr + r[:, None] * HS + d[None, :], mask=rm[:, None], other=0.0).to(tl.float32)
+    g = tl.zeros((RP, BLK), dtype=tl.float32)
+    for s in tl.static_range(4):
+        is_ = tl.sum(tl.where(i4[None, :] == s, inj, 0.0), axis=1)
+        g = tl.where((s_of == s)[None, :], is_[:, None], g)
+    tl.store(out_ptr + r[:, None] * HD + cols[None, :], (xv + bo * g).to(out_ptr.dtype.element_ty), mask=rm[:, None])
+
+
+def supported(gr, x: torch.Tensor) -> bool:
+    c = gr.config
+    return (x.device.type == "xpu" and x.dim() == 2 and 0 < x.shape[0] <= MAX_ROWS and gr.hc_count == 4
+            and c.hc_per_branch_norm and x.shape[1] == 4 * gr.hidden_size and gr.hidden_size % _CH == 0
+            and gr.hidden_size % _DB == 0 and x.dtype == torch.bfloat16 and hasattr(gr, "input_mix_weight_down"))
+
+
+def mix(gr, x: torch.Tensor):
+    """GatedResidual.mix for small row counts. Returns (mixed [R, HS] bf16, residual state for combine)."""
+    x = x.contiguous()
+    R, HD = x.shape
+    HS = gr.hidden_size
+    wd = gr.input_mix_weight_down.weight
+    wu = gr.input_mix_weight_up.weight
+    L = wd.shape[0]
+    NC = HD // _CH
+    CPS = HS // _CH
+    RP = 16
+    dev = x.device
+    has_inj = hasattr(gr, "block_inject_weight")
+    wi = gr.block_inject_weight.weight if has_inj else wd
+    pd = torch.empty((R, NC, L), dtype=torch.float32, device=dev)
+    pi = torch.empty((R, NC, 4), dtype=torch.float32, device=dev)
+    ss = torch.empty((R, NC), dtype=torch.float32, device=dev)
+    rs = torch.empty((R, 4), dtype=torch.float32, device=dev)
+    out = torch.empty((R, HS), dtype=torch.bfloat16, device=dev)
+    wn = gr.hc_norm.weight
+    _hc_k1[(NC, triton.cdiv(L, _LB))](x, wn, wd, wi, pd, pi, ss, R, HD, L, NC, HAS_INJ=has_inj, CH=_CH, LB=_LB,
+                                      SUB=_SUB, RP=RP, num_warps=4)
+    _hc_k2[(HS // _DB,)](x, wn, wu, pd, ss, rs, out, R, HS, L, NC, CPS, float(gr.hc_norm.variance_epsilon),
+                         1.0 / gr.hc_count, RP=RP, LP=triton.next_power_of_2(L), NCP=triton.next_power_of_2(NC),
+                         DB=_DB, num_warps=4)
+    return out, ("exl3_hc", x, pi, rs)
+
+
+def combine(gr, block_output: torch.Tensor, state) -> torch.Tensor:
+    _, x, pi, rs = state
+    R, HD = x.shape
+    HS = gr.hidden_size
+    NC = HD // _CH
+    out = torch.empty_like(x)
+    _hc_k3[(triton.cdiv(HD, _K3B),)](x, block_output.contiguous(), pi, rs, out, R, HS, NC, HS // _CH, 1.0 / gr.hc_count,
+                                     RP=16, NCP=triton.next_power_of_2(NC), BLK=_K3B, num_warps=4)
+    return out
+
+
+def install() -> bool:
+    if os.environ.get("EXL3_HC_FUSED", "0") != "1":
+        return False
+    from sglang.srt.layers import hyperconnection as hcm
+    G = hcm.GatedResidual
+    if getattr(G, "_exl3_hc", False):
+        return True
+    orig_mix, orig_combine = G.mix, G.combine
+
+    def mix_(self, hyper_input):
+        if supported(self, hyper_input):
+            return mix(self, hyper_input)
+        return orig_mix(self, hyper_input)
+
+    def combine_(self, block_output, residuals):
+        if isinstance(residuals, tuple) and len(residuals) == 4 and residuals[0] == "exl3_hc":
+            return combine(self, block_output, residuals)
+        return orig_combine(self, block_output, residuals)
+
+    G.mix, G.combine = mix_, combine_
+    G._exl3_hc = True
+    return True
