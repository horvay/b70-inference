+def qsa_sparse_attention_decode(q, k_cache, v_cache, token_slots, softmax_scale=None, block_split=128, bn=32):
+    split_kernel, merge_kernel, triton = _qsa_kernels()
+    scale = softmax_scale or q.shape[-1] ** -0.5
+    R, Hq, D = q.shape
+    Hk = k_cache.shape[1]
+    G = Hq // Hk
+    GP = max(16, triton.next_power_of_2(G))
+    S = token_slots.shape[1]
