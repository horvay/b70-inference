+def _expand_fast():
+    """SGLang's expand_qsa_block_indices runs its Triton kernel on CUDA only and a stable argsort per row elsewhere:
+    26 ms per layer at 8192 rows on the B70 against 0.3 ms for the same Triton kernel, bit-identical
+    (tests/bench_qsa_select.py). Use the Triton kernel on XPU outside graph capture (EXL3_QSA_TRITON_EXPAND=1, default);
