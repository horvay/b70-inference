new file mode 100644
index 0000000..58ab3a3
--- /dev/null
+++ i/xpu/csrc/cold_read.c
@@ -0,0 +1,68 @@
+// B70 cold tier: parallel O_DIRECT reads of expert records from the NVMe store (moe_offload.ColdStore.read).
+// Called through ctypes, which releases the GIL for the whole call: the Python thread pool it replaces took ~500
+// futures per layer and fought the main thread (which enqueues the forward) for the GIL.
+//
+//   cold_read(fd, offs, n, dst, rec, nthreads, npieces) -> 0, or -1 with errno set
+// reads n records of `rec` bytes, record i from file offset offs[i] into dst + i * rec, each record split into
+// npieces 4 KiB-aligned pieces, the n * npieces pieces spread over nthreads threads (work stealing by an atomic index).
+#define _GNU_SOURCE
+#include <errno.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <unistd.h>
+
+typedef struct {
+    int fd;
+    const int64_t *offs;
+    int64_t n, rec, piece, npieces;
+    char *dst;
+    atomic_long next;
+    atomic_int err;
+} job_t;
+
+static void *worker(void *arg) {
+    job_t *j = arg;
+    const int64_t total = j->n * j->npieces;
+    for (;;) {
+        int64_t k = atomic_fetch_add(&j->next, 1);
+        if (k >= total || atomic_load(&j->err)) break;
+        int64_t i = k / j->npieces, off = (k % j->npieces) * j->piece;
+        int64_t len = j->rec - off < j->piece ? j->rec - off : j->piece;
+        char *d = j->dst + i * j->rec + off;
+        int64_t got = 0;
+        while (got < len) {
+            ssize_t r = pread(j->fd, d + got, (size_t)(len - got), j->offs[i] + off + got);
+            if (r <= 0) {
+                atomic_store(&j->err, r < 0 ? errno : EIO);
+                return NULL;
+            }
+            got += r;
+        }
+    }
+    return NULL;
+}
+
+int cold_read(int fd, const int64_t *offs, int64_t n, char *dst, int64_t rec, int nthreads, int npieces) {
+    if (n <= 0) return 0;
+    if (npieces < 1) npieces = 1;
+    job_t j = {.fd = fd, .offs = offs, .n = n, .rec = rec, .npieces = npieces, .dst = dst};
+    j.piece = ((rec / 4096 + npieces - 1) / npieces) * 4096;
+    j.npieces = (rec + j.piece - 1) / j.piece;
+    atomic_init(&j.next, 0);
+    atomic_init(&j.err, 0);
+    if (nthreads > 64) nthreads = 64;
+    if ((int64_t)nthreads > n * j.npieces) nthreads = (int)(n * j.npieces);
+    pthread_t th[64];
+    int started = 0;
+    for (int t = 0; t < nthreads; t++)
+        if (pthread_create(&th[t], NULL, worker, &j) == 0) started++;
+    if (!started) worker(&j);
+    for (int t = 0; t < started; t++) pthread_join(th[t], NULL);
+    int e = atomic_load(&j.err);
+    if (e) {
+        errno = e;
+        return -1;
+    }
+    return 0;
+}
