+    po = torch.empty((R, Hk, nsplit, GP, D), dtype=torch.float32, device=q.device)
+    pm = torch.empty((R, Hk, nsplit, GP), dtype=torch.float32, device=q.device)
+    pl = torch.empty((R, Hk, nsplit, GP), dtype=torch.float32, device=q.device)
