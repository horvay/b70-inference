+"""
+QSA prefill token selection on the B70 (QSAIndexer.select_prefill_tokens), step by step, against faster versions:
+  - MQA logits: SGLang's torch fallback (fp32 einsum into [rows, keys, heads]) vs per-head fp32 GEMMs
+  - top-k: the plugin's qsa_fast_topk
+  - block -> token expansion: SGLang's torch fallback (stable argsort per row) vs its Triton kernel (CUDA-only in
+    SGLang) vs a sort-free scatter
+Synthetic data at Qwen3.8-Flash-Next shapes (4 index heads x 128, compress ratio 4, 2048 selected tokens).
+
+  python3 tests/bench_qsa_select.py --rows 8192 --keys 16384
+"""
+import argparse
+import os
+import sys
+import time
+
+import torch
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.join(HERE, ".."))
+from exl3xpu import qsa_xpu  # noqa: E402
+from sglang.srt.layers.attention.qsa import kernel as K  # noqa: E402
+from sglang.srt.layers.attention.qsa.mqa import torch_qsa_mqa_prefill  # noqa: E402
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--rows", type=int, default=8192)
+ap.add_argument("--keys", type=int, default=16384)
+ap.add_argument("--iters", type=int, default=3)
+a = ap.parse_args()
+dev = torch.device("xpu", 0)
+H, D, RATIO, TOKEN_TOPK = 4, 128, 4, 2048
+BLOCK_TOPK = TOKEN_TOPK // RATIO
+R, L = a.rows, a.keys
+C = L // RATIO
+g = torch.Generator(device="cpu").manual_seed(0)
+q = (torch.randn((R, H, D), generator=g)).to(torch.bfloat16).to(dev)
+k = (torch.randn((C, 1, D), generator=g)).to(torch.bfloat16).to(dev)
+pos = torch.arange(L - R, L, device=dev)
+row_starts = torch.zeros(R, dtype=torch.int32, device=dev)
+row_ends = ((pos + 1) // RATIO).to(torch.int32)
+seq_lens = torch.full((R,), L, dtype=torch.int32, device=dev)
+
+
+def t(fn, name):
+    out = fn()
+    torch.xpu.synchronize()
+    t0 = time.perf_counter()
+    for _ in range(a.iters):
+        out = fn()
+    torch.xpu.synchronize()
+    print(f"{name:40s} {(time.perf_counter() - t0) / a.iters * 1e3:8.1f} ms", flush=True)
+    return out
+
+
+def mqa_gemm(q, k, row_starts, row_ends):
+    kf = k[:, 0].float().t()                                   # [D, C]
+    logits = torch.relu(q[:, 0].float() @ kf)
+    for h in range(1, q.shape[1]):
+        logits.add_(torch.relu(q[:, h].float() @ kf))
+    logits.div_(q.shape[-1] ** 0.5)
+    cols = torch.arange(k.shape[0], device=q.device).unsqueeze(0)
+    valid = (cols >= row_starts.reshape(-1, 1)) & (cols < row_ends.reshape(-1, 1))
+    return logits.masked_fill_(~valid, -float("inf"))
+
+
+ref = t(lambda: torch_qsa_mqa_prefill(q, k, row_starts, row_ends), "mqa: torch fallback (einsum)")
+new = t(lambda: mqa_gemm(q, k, row_starts, row_ends), "mqa: per-head fp32 GEMM")
+fin = torch.isfinite(ref)
+print(f"   max|diff| {(ref[fin] - new[fin]).abs().max().item():.2e}, same -inf mask {torch.equal(fin, torch.isfinite(new))}")
+blocks = t(lambda: qsa_xpu.qsa_fast_topk(ref, row_starts, row_ends, BLOCK_TOPK), "top-k (plugin qsa_fast_topk)")
+blocks_new = qsa_xpu.qsa_fast_topk(new, row_starts, row_ends, BLOCK_TOPK)
+same = (blocks.sort(1).values == blocks_new.sort(1).values).all(1).float().mean().item()
+print(f"   rows with the same selected block set from the GEMM logits: {same:.4%}")
+
+
+def expand_scatter(block_indices, query_positions, sequence_lengths, compress_ratio, token_topk):
+    """Sort-free expansion, same output as SGLang's torch version when the valid blocks form a prefix of each row
+    (qsa_fast_topk writes them first): valid tokens first, then the partial tail block, -1 after."""
+    rows, bt = block_indices.shape
+    final = token_topk + compress_ratio - 1
+    dev_ = block_indices.device
+    blocks = block_indices.long()
+    offs = torch.arange(compress_ratio, device=dev_)
+    exp = (blocks.unsqueeze(-1) * compress_ratio + offs).reshape(rows, bt * compress_ratio)[:, :token_topk]
+    ok = (blocks >= 0).unsqueeze(-1).expand(rows, bt, compress_ratio).reshape(rows, -1)[:, :token_topk]
+    ok = ok & (exp < sequence_lengths.long().unsqueeze(1))
+    n_ok = ok.sum(1)                                                          # valid expanded tokens per row
+    vis = query_positions.long() + 1
+    tail_start = vis // compress_ratio * compress_ratio
+    j = torch.arange(compress_ratio - 1, device=dev_).unsqueeze(0)
+    tail = tail_start.unsqueeze(1) + j
+    tail_ok = (j < (vis - tail_start).unsqueeze(1)) & (tail < sequence_lengths.long().unsqueeze(1))
+    out = torch.full((rows, final + 1), -1, dtype=torch.long, device=dev_)
+    dump = torch.full_like(exp, final)
+    col = torch.arange(token_topk, device=dev_).unsqueeze(0).expand(rows, -1)
+    out.scatter_(1, torch.where(ok, col, dump), torch.where(ok, exp, torch.full_like(exp, -1)))
+    out[:, final] = -1
+    tcol = torch.where(tail_ok, n_ok.unsqueeze(1) + j, torch.full_like(tail, final))
+    out.scatter_(1, tcol, torch.where(tail_ok, tail, torch.full_like(tail, -1)))
+    return out[:, :final].to(torch.int32)
+
+
+e_ref = t(lambda: K.torch_expand_qsa_block_indices(blocks, pos, seq_lens, RATIO, TOKEN_TOPK), "expand: torch fallback (argsort)")
+try:
+    e_tri = t(lambda: K.triton_expand_qsa_block_indices(blocks, pos, seq_lens, RATIO, TOKEN_TOPK), "expand: SGLang Triton kernel")
+    print(f"   equal to fallback: {torch.equal(e_ref, e_tri)}")
+except Exception as e:
+    print(f"expand: Triton kernel failed: {type(e).__name__}: {str(e)[:200]}")
+e_sc = t(lambda: expand_scatter(blocks, pos, seq_lens, RATIO, TOKEN_TOPK), "expand: sort-free scatter")
+print(f"   equal to fallback: {torch.equal(e_ref, e_sc)}")
